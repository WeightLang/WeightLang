wgt 0.5
model TinyCNN1D
input x: f32[10]
output y: f32[12]
# 通道在前，最后的 1 个轴为空间轴；参数是初始化值，不是训练结果。
parameter kernel: f32[4,1,3] = [-0.25,-0.1,0.05,0.2,-0.2,-0.05,0.1,0.25,-0.15,0.0,0.15,-0.25]
parameter bias: f32[4] = [0.02,0.04,0.06,0.08]
fn forward(x) {
    # 显式恢复输入与 kernel 几何；分组 2，同一 kernel 在各空间位置共享。
    # stride/padding/dilation 分别为 [2]/[1]/[1]；输出 [4, 3]。
    let features = conv(reshape(x,[2,5]),reshape(kernel,[4,1,3]),bias,[2],[1],[1],2);
    # 非线性特征提取后展平；宿主只管理输入、训练循环与权重持久化。
    return reshape(tanh(features),[12]);
}
fn loss(prediction,target) { return square(prediction-target).mean; }
