wgt 0.3

block conv_relu(in, out, kernel):
  layer conv: conv2d(in=in, out=out, kernel=kernel)
  layer act: relu

block conv_pool(in, out, kernel, pool):
  layer conv: conv_relu(in=in, out=out, kernel=kernel)
  layer pool: maxpool2d(kernel=pool, stride=pool)

# Global spatial averaging keeps channel features and allows a linear head.
block classifier(channels, classes):
  layer pool: globalavgpool2d
  layer logits: linear(in=channels, out=classes)
