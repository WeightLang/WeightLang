wgt 0.3

# Transformers 5.7.0 的基础解码器组合；结构不携带训练权重。
# 所有形状都是 [time, feature]，batch 由运行时添加。残差要求输入输出同形。
block gpt2_block(dim, heads, hidden, eps=0.00001, attn_dropout=0.1, resid_dropout=0.1):
  layer norm1: layernorm(dim=dim, eps=eps)
  layer attention: self_attention(dim=dim, heads=heads, causal=1, dropout=attn_dropout)
  layer attention_dropout: dropout(p=resid_dropout)
  layer attended: add(input, attention_dropout)
  layer norm2: layernorm(dim=dim, eps=eps)
  layer up: linear(in=dim, out=hidden)
  # GPT-2 使用 tanh 近似 GELU，不能用默认精确 GELU 替代。
  layer activation: gelu(approximate=1)
  layer down: linear(in=hidden, out=dim)
  layer mlp_dropout: dropout(p=resid_dropout)
  layer output: add(attended, mlp_dropout)

# 全序列 causal GQA；半维旋转 RoPE，位置从 0 开始；不含 padding mask/KV cache。
# q/k 头归一化由 qk_norm 控制，window=0 表示全 causal 注意力。
block rope_block(dim, heads, kv_heads, head_dim, hidden, eps=0.000001, theta=10000, qk_norm=0, qkv_bias=0, out_bias=0, mlp_bias=0, window=0, attn_dropout=0):
  layer norm1: rmsnorm(dim=dim, eps=eps)
  layer attention: rope_attention(dim=dim, heads=heads, kv_heads=kv_heads, head_dim=head_dim, theta=theta, eps=eps, qk_norm=qk_norm, qkv_bias=qkv_bias, out_bias=out_bias, window=window, dropout=attn_dropout)
  layer attended: add(input, attention)
  layer norm2: rmsnorm(dim=dim, eps=eps)
  # gate 与 value 参数独立；SiLU 门不是概率，逐元素乘积不进行广播。
  layer gate: linear(in=dim, out=hidden, bias=mlp_bias) -> silu
  layer value: linear(in=dim, out=hidden, bias=mlp_bias) from norm2
  layer gated: mul(gate, value)
  layer down: linear(in=hidden, out=dim, bias=mlp_bias)
  layer output: add(attended, down)

# Gemma 1：RMSNorm 的可训练权重以 0 初始化，实际缩放为 1+weight。
block gemma_block(dim, heads, kv_heads, head_dim, hidden, eps=0.000001, theta=10000, attention_bias=0, attn_dropout=0):
  layer norm1: rmsnorm(dim=dim, eps=eps, offset=1)
  layer attention: rope_attention(dim=dim, heads=heads, kv_heads=kv_heads, head_dim=head_dim, theta=theta, qkv_bias=attention_bias, out_bias=attention_bias, dropout=attn_dropout)
  layer attended: add(input, attention)
  layer norm2: rmsnorm(dim=dim, eps=eps, offset=1)
  layer gate: linear(in=dim, out=hidden, bias=0) -> gelu(approximate=1)
  layer value: linear(in=dim, out=hidden, bias=0) from norm2
  layer gated: mul(gate, value)
  layer down: linear(in=hidden, out=dim, bias=0)
  layer output: add(attended, down)

# OLMo 1：LayerNorm 无可训练 affine 参数；clip=0 表示不裁剪 Q/K/V。
block olmo_block(dim, heads, kv_heads, head_dim, hidden, theta=10000, attention_bias=0, attn_dropout=0, clip=0):
  layer norm1: layernorm(dim=dim, affine=0)
  layer attention: rope_attention(dim=dim, heads=heads, kv_heads=kv_heads, head_dim=head_dim, theta=theta, qkv_bias=attention_bias, out_bias=attention_bias, dropout=attn_dropout, clip=clip)
  layer attended: add(input, attention)
  layer norm2: layernorm(dim=dim, affine=0)
  layer gate: linear(in=dim, out=hidden, bias=0) -> silu
  layer value: linear(in=dim, out=hidden, bias=0) from norm2
  layer gated: mul(gate, value)
  layer down: linear(in=hidden, out=dim, bias=0)
  layer output: add(attended, down)

# StarCoder2：普通 tanh-GELU FFN，不使用门控；LayerNorm 的 bias 始终保留。
block starcoder2_block(dim, heads, kv_heads, head_dim, hidden, eps=0.00001, theta=10000, bias=1, window=0, attn_dropout=0, resid_dropout=0):
  layer norm1: layernorm(dim=dim, eps=eps)
  layer attention: rope_attention(dim=dim, heads=heads, kv_heads=kv_heads, head_dim=head_dim, theta=theta, qkv_bias=bias, out_bias=bias, window=window, dropout=attn_dropout)
  layer attention_dropout: dropout(p=resid_dropout)
  layer attended: add(input, attention_dropout)
  layer norm2: layernorm(dim=dim, eps=eps)
  layer up: linear(in=dim, out=hidden, bias=bias)
  layer activation: gelu(approximate=1)
  layer down: linear(in=hidden, out=dim, bias=bias)
  layer mlp_dropout: dropout(p=resid_dropout)
  layer output: add(attended, mlp_dropout)

# OLMo2/3：window=0 为完整 causal；OLMo3 按层传入滑动窗口大小。
# 先在完整 Q/K 投影向量上归一化，再拆分头；不能用每头归一化替代。
# 两条残差分支在输出端归一化；FFN 直接读取 attended，gate/value 参数独立。
block olmo2_block(dim, heads, kv_heads, head_dim, hidden, eps=0.000001, theta=10000, attention_bias=0, attn_dropout=0, window=0):
  layer attention: rope_attention(dim=dim, heads=heads, kv_heads=kv_heads, head_dim=head_dim, theta=theta, eps=eps, qk_norm=2, qkv_bias=attention_bias, out_bias=attention_bias, dropout=attn_dropout, window=window)
  layer norm1: rmsnorm(dim=dim, eps=eps)
  layer attended: add(input, norm1)
  layer gate: linear(in=dim, out=hidden, bias=0) -> silu
  layer value: linear(in=dim, out=hidden, bias=0) from attended
  layer gated: mul(gate, value)
  layer down: linear(in=hidden, out=dim, bias=0)
  layer norm2: rmsnorm(dim=dim, eps=eps)
  layer output: add(attended, norm2)
