wgt 0.5
model iris
# Feature order: sepal length/width, petal length/width in cm; outputs are raw class logits.
input features: f32[4]
output scores: logits[3]
# The model definition contains architecture and initialization only; Rust owns data and training control.
layer hidden: linear(out=16)
layer act: tanh
layer projection: linear(out=8)
layer projection_act: tanh
layer classifier: linear(out=3)
init seed=42
