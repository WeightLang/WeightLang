wgt 0.5
model iris
# 特征依次为萼片长/宽、花瓣长/宽，单位 cm；输出为三个类别的原始 logits。
input features: f32[4]
output scores: logits[3]
# 共享同一个模型句柄训练；各层独立权重。0.5 原生模型使用 tanh，不复用旧权重。
layer hidden: linear(out=16)
layer act: tanh
layer projection: linear(out=8)
layer projection_act: tanh
layer classifier: linear(out=3)
init seed=42

fn accuracy(net, rows) {
    let correct = 0;
    for row in rows {
        let logits = net(row["input"]);
        let best = 0;
        for i in range(1, 3) {
            if logits[i] > logits[best] { best = i; }
        }
        if best == row["target"] { correct = correct + 1; }
    }
    return correct;
}
fn main() {
    let net = iris("adam");
    let reader = jsonl("train.jsonl");
    let rows = batch(reader, 120);
    close(reader);
    assert(len(rows) == 120, "expected fixed training split");
    let loss = 0;
    # 固定训练设置；test.jsonl 从不传给 fit，不参与调参或选权重。
    for epoch in range(0, 400) {
        loss = fit(net, column(rows, "input"), column(rows, "target"), 0.01, "cross_entropy");
    }
    metric("train_correct", accuracy(net, rows));
    metric("train_total", 120);
    metric("final_cross_entropy", loss);
    let validation = jsonl("test.jsonl");
    let held_out = batch(validation, 30);
    close(validation);
    assert(len(held_out) == 30, "expected fixed held-out split");
    metric("test_correct", accuracy(net, held_out));
    metric("test_total", 30);
    return net;
}
