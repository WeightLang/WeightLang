wgt 0.5
# Published as github.com/WeightLang/WeightLang/packages/gates/and_mlp.
# 定义 2→8→1 tanh/sigmoid 模型；参数由显式初始化请求按 seed=42 生成，未训练。
model and_mlp
input bits: f32[2]
output prob: f32[1]
layer hidden: linear(in=2, out=8)
layer act: tanh
layer head: linear(in=8, out=1)
layer out: sigmoid
init weights=xavier_uniform(42) bias=zeros()
