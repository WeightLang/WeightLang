wgt 0.5
# 此示例显式覆盖当前示例自己的输出；请先创建 weights/file_io 目录。
# 路径相对本入口目录。初始化不等于已训练，保存模型不保存优化器状态。
fn main() {
    save text "原生 UTF-8 文件" to "../../../weights/file_io/message.txt" overwrite;
    let message = load text from "../../../weights/file_io/message.txt";
    assert message == "原生 UTF-8 文件", "文本往返失败";
    save json [message,true,null] to "../../../weights/file_io/data.json" overwrite;
    let data = load json from "../../../weights/file_io/data.json";
    # 输入/输出均为单个标量组成的向量；这里尚未执行训练。
    let net = mlp([1,1], "identity", 4, "adam");
    save model net to "../../../weights/file_io/model.json" overwrite;
    save checkpoint net to "../../../weights/file_io/checkpoint.json" overwrite;
    let inference = load model from "../../../weights/file_io/model.json" using "adam";
    let resumed = load checkpoint from "../../../weights/file_io/checkpoint.json";
    assert net([1]) == inference([1]);
    assert net([1]) == resumed([1]);
    return data;
}
