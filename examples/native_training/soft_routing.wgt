wgt 0.5
model SoftRouter
input x: f32[1]
output y: f32[1]
# 单样本单特征。两个固定专家分别输出 x 和 -x；目标是学会近似 abs(x)。
frozen positive_expert: f32[1,1] = [1]
frozen negative_expert: f32[1,1] = [-1]
# 初始权重不是训练结果。router 学习按输入符号分流，openness 学习门的开放程度。
parameter router: f32[1,1] = [0.1]
parameter openness: f32[1] = [0]
fn forward(x) {
    let p = sigmoid(linear(x, router));
    # 两路输出均为 [1]；训练需两边的梯度，推理在 p 恰为 0/1 时跳过无关表达式。
    # p 是混合比例，不是抽样概率；本例通常处于 0 与 1 之间，仍计算两边。
    let mixed = route(p, linear(x, positive_expert), linear(x, negative_expert));
    return gate(sigmoid(openness), mixed);
}
fn main() {
    let model = SoftRouter("adam");
    let xs = [[-2], [-1], [1], [2]];
    let targets = [[2], [1], [1], [2]];
    let before = fit(model, xs, targets, 0.05, "mse");
    # 每次迭代更新同一个模型的共享参数；不是创建 500 组独立路由权重。
    for step in range(0, 500) {
        fit(model, xs, targets, 0.05, "mse");
    }
    let after = fit(model, xs, targets, 0.05, "mse");
    assert(after < before * 0.01, "soft routing did not learn");
    metric("loss_before", before);
    metric("loss_after", after);
    return model([-1]);
}
