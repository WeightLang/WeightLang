wgt 0.5
fn main() {
    seed(42);
    let selected = 0;
    # 每次独立抽样；只有选中的表达式执行。此处是宿主标量，不建立梯度图。
    for i in range(0, 1000) {
        let choice = sample 0.7 {
            then { 1 }
            else { 0 }
        };
        selected = selected + choice;
    }
    # 端点不抽随机数；未选中的错误表达式也不会执行。
    let exact = sample 1 { then { 7 } else { 1 / 0 } };
    assert(exact == 7, "sampling did not short circuit");
    assert(selected > 600 && selected < 800, "unexpected sample frequency");
    # 类别轴长度为 4；采样出的离散动作转成模型可接收的向量，不对索引求导。
    let action = sample 1 { then { 2 } else { 0 } };
    let encoded = onehot[4] action;
    assert(encoded == [0, 0, 1, 0], "onehot shape or index mismatch");
    return selected;
}
