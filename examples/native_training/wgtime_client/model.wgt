wgt 0.5
# 第一片客户端只持有模型租约；[2,4,1] 为输入、隐藏与输出特征宽度。
# 每次 fit 在服务端执行反向与 Adam 提交；客户端循环和指标留在本进程。
# 初始随机参数尚未训练，完成 20 步后只报告损失，不自动保存制品。
fn main() {
    let net = mlp([2, 4, 1], "tanh", 42, "adam");
    let inputs = [[0.1, 0.2], [0.3, 0.4]];
    let targets = [[0.3], [0.7]];
    let loss = 0;
    for step in range(0, 20) {
        loss = fit(net, inputs, targets, 0.01, "mse");
    }
    metric("loss", loss);
    return net([0.1, 0.2]);
}
