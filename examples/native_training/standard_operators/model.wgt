wgt 0.5
import activation from "std/activation"
import loss_ops from "std/loss"
model StandardOperators
input x: f32[3]
output y: f32[3]
# 三个独立特征的缩放参数；初始化不等于训练，各步共享此 gain。
parameter gain: f32[3] = [1, 1, 1]
fn forward(x) {
    # 两路均为 [特征=3]，库只完成SiLU门乘，不隐式创建投影或广播。
    return activation.swiglu(x, x * gain);
}
fn loss(prediction, target) {
    # 特征平方误差平均为 [1]；训练器另在最外层样本轴平均。
    return loss_ops.squared_error(prediction, target);
}
fn main() {
    let net = StandardOperators("adam");
    let before = fit(net, [[-1, 0, 2], [1, -2, 0]], [[0, 0, 0], [0, 0, 0]], 0.03, "loss");
    for step in range(0, 40) {
        fit(net, [[-1, 0, 2], [1, -2, 0]], [[0, 0, 0], [0, 0, 0]], 0.03, "loss");
    }
    let after = fit(net, [[-1, 0, 2], [1, -2, 0]], [[0, 0, 0], [0, 0, 0]], 0.03, "loss");
    assert after < before * 0.1, "standard WGT operators must propagate training gradients";
    return net([-1, 0, 2]);
}
