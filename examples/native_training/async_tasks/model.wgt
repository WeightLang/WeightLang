wgt 0.5
# 每个任务只接收独立标量，不共享模型、Reader 或可变资源。
# async 调用创建冷 future；sleep 在两个固定工作线程中重叠等待。
async fn score(value) {
    await sleep(20);
    return value + 1;
}
async fn twice(value) {
    # 嵌套 await 按任务内顺序驱动，同一任务使用独立的 RNG 流和共享总预算。
    return await score(await score(value));
}
fn main() {
    tasks {
        # 先提交全部子任务，再 await。作用域退出会 join，错误会取消兄弟任务。
        let first = spawn twice(40);
        let second = spawn score(0);
        let result = await first;
        assert await second == 1, "second task result";
        return result;
    }
}
