wgt 0.5
model LearnedChoice
input x: f32[1]
output y: f32[1]
# prob 对用户呈现概率，优化器训练其内部 logit；0.2 是初始化而非训练结果。
parameter p: prob = 0.2
frozen zero: f32[1] = [0]
fn forward(x) {
    # 两个分支均输出 [1]；同一参数 p 在全部样本及训练迭代间共享。
    # 推理时精确 0/1 短路；训练保留两边，以学习混合比例。
    return mix p {
        then { x }
        else { zero }
    };
}
fn loss(prediction, target) {
    # 输入是单个样本的输出向量；先逐特征平方，再归约为 [1]。
    # fit 负责在样本轴上取平均，损失梯度穿过 mix 回传到 p 的 logit。
    let error = prediction - target;
    return mean(square(error));
}
fn main() {
    let model = LearnedChoice("adam");
    let before = fit(model, [[1]], [[0.8]], 0.05, "loss");
    for step in range(0, 200) {
        fit(model, [[1]], [[0.8]], 0.05, "loss");
    }
    let after = fit(model, [[1]], [[0.8]], 0.05, "loss");
    assert(after < before * 0.001, "custom loss did not train probability");
    metric("loss_before", before);
    metric("loss_after", after);
    return model([1]);
}
