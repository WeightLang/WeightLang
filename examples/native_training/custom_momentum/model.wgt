wgt 0.5
model Regression
input x: f32[1]
output y: f32[1]
# [输出=1, 输入=1]；零值是初始化，只有 main 显式提交后才是更新权重。
parameter w: f32[1,1] = [0]
fn forward(x) { return linear(x, w); }
fn loss(prediction, target) {
    # 单样本输出轴归约为 [1]；differentiate 负责样本轴平均。
    return square(prediction - target).mean;
}

fn momentum(parameters, gradients, state, rate, beta) {
    # 状态完全由 WGT 定义：[算法版本, 每参数速度]；beta=0 即普通 SGD。
    let velocities = [];
    if state != null {
        assert state[0] == 1, "unsupported momentum state version";
        velocities = state[1];
    }
    let candidates = [];
    let next_velocities = [];
    for p in range(0, len(parameters)) {
        let values = [];
        let velocity = [];
        for j in range(0, len(parameters[p])) {
            let previous = 0;
            if state != null { previous = velocities[p][j]; }
            # 可直接修改这一更新公式；各参数各元素的速度独立保存。
            let v = beta * previous + gradients[p][j];
            velocity = append(velocity, v);
            values = append(values, parameters[p][j] - rate * v);
        }
        candidates = append(candidates, values);
        next_velocities = append(next_velocities, velocity);
    }
    return [candidates, [1, next_velocities]];
}

fn update_once(net, inputs, targets, rate, beta) {
    let gradient = differentiate(net, inputs, targets);
    let snapshot = gradient_snapshot(gradient);
    let proposal = momentum(snapshot["parameters"], snapshot["gradients"],
        snapshot["state"], rate, beta);
    # 权重和速度一起提交；失败不提交任一部分，成功自动释放梯度句柄。
    return commit_gradients(gradient, proposal[0], proposal[1]);
}

fn main() {
    let net = Regression("none");
    let inputs = [[1], [2]];
    let targets = [[2], [4]];
    let initial = update_once(net, inputs, targets, 0.02, 0.9);
    for epoch in range(0, 19) {
        metric("loss", update_once(net, inputs, targets, 0.02, 0.9));
    }
    # 调用方需先创建 weights/custom_momentum；已有文件拒绝覆盖。
    save checkpoint net to "../../../weights/custom_momentum/step20.json";
    let resumed = load checkpoint from "../../../weights/custom_momentum/step20.json";
    let a = update_once(net, inputs, targets, 0.02, 0.9);
    let b = update_once(resumed, inputs, targets, 0.02, 0.9);
    assert a == b, "resumed pre-update loss";
    assert net([3]) == resumed([3]), "resumed momentum weights";
    let ga = differentiate(net, inputs, targets);
    let gb = differentiate(resumed, inputs, targets);
    let sa = gradient_snapshot(ga);
    let sb = gradient_snapshot(gb);
    assert sa["state"] == sb["state"], "resumed velocity state";
    assert sa["steps"] == 21, "committed custom step count";
    assert sa["loss"] < initial, "custom momentum must learn";
    release_gradient(ga);
    release_gradient(gb);
    return net([3]);
}
