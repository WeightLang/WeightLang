wgt 0.5
# 两维策略观测：[任务需要精确求和, 单位工作量价格]；两维输出为动作 logits。
# 动作 0 直接回答 0，动作 1 调用整数求和。简单任务答案已知为 0。
# 策略不接收计算结果作为训练标签，使用实际成功率和运行时扣费形成奖励。
fn main() {
    compute_budget(500000, 4096, 10000, 60000);
    seed(2026);
    let policy = mlp([2, 8, 2], "tanh", 42, "adam");
    for step in range(0, 3000) {
        let need = step % 2;
        let price = 0.1;
        if step % 4 >= 2 { price = 0.8; }
        let observation = [need, price];
        let x = 0;
        let y = 0;
        if need == 1 { x = step % 31 + 1; y = step % 17 + 1; }
        let action = sample(policy, observation);
        let answer = 0;
        let work = 0;
        if action == 1 {
            let result = compute_call("integer_sum.v1", [x, y]);
            assert(result["ok"], "training resource budget exhausted");
            answer = result["value"];
            work = result["work"];
        }
        let reward = 0;
        if answer == x + y { reward = 1; }
        reward = reward - price * work;
        # 单步回合使用奖励减固定基线作为优势；所有回合共享 policy 参数。
        reinforce(policy, [observation], [action], [reward - 0.2], 0.01);
    }
    let correct_decisions = 0;
    let low_price_successes = 0;
    let low_price_work = 0;
    let fixed_work = 0;
    let fixed_successes = 0;
    let no_call_successes = 0;
    for context in range(0, 4) {
        let need = context % 2;
        let price = 0.1;
        if context >= 2 { price = 0.8; }
        let scores = predict(policy, [need, price]);
        let action = 0;
        if scores[1] > scores[0] { action = 1; }
        let expected = 0;
        if need == 1 && price == 0.1 { expected = 1; }
        if action == expected { correct_decisions = correct_decisions + 1; }
        # 评估使用超出训练数值范围的整数；执行结果必须精确相等。
        let x = 0;
        let y = 0;
        if need == 1 { x = 1234567; y = 7654321; }
        let answer = 0;
        let work = 0;
        if action == 1 {
            let result = compute_call("integer_sum.v1", [x, y]);
            assert(result["ok"], "evaluation failed");
            answer = result["value"];
            work = result["work"];
        }
        if price == 0.1 {
            let fixed = compute_call("integer_sum.v1", [x, y]);
            assert(fixed["ok"], "fixed baseline failed");
            fixed_work = fixed_work + fixed["work"];
            if fixed["value"] == x + y { fixed_successes = fixed_successes + 1; }
            if 0 == x + y { no_call_successes = no_call_successes + 1; }
            if answer == x + y { low_price_successes = low_price_successes + 1; }
            low_price_work = low_price_work + work;
        }
    }
    metric("decision_accuracy", correct_decisions / 4);
    metric("low_price_success_rate", low_price_successes / 2);
    metric("learned_work_per_task", low_price_work / 2);
    metric("always_call_work_per_task", fixed_work / 2);
    metric("always_call_success_rate", fixed_successes / 2);
    metric("no_call_success_rate", no_call_successes / 2);
    assert(correct_decisions == 4, "policy did not learn cost-sensitive decisions");
    assert(low_price_successes == 2 && low_price_work == 2, "equal-success cost comparison failed");
    return true;
}
