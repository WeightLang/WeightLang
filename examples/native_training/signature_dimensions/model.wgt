wgt 0.5
# N 是构造时确定的特征数；宿主可以覆盖默认值，不是运行时 batch 轴。
dim N = 2
model Projection
# 行/列分别表示输出/输入特征。定义只记录配方，实例化才创建权重。
parameter weight: f32[N,N] = eye()
parameter bias: f32[N] = zeros()

# 接口直接写在函数上；同一 weight 的每次读取共享该实例的参数。
fn forward(x: f32[N]) -> f32[N] {
    return linear(x, weight, bias);
}

# 在特征轴归约为一个标量；宿主负责样本批次、优化器和训练循环。
fn loss(prediction: f32[N], target: f32[N]) -> f32[1] {
    return 0.5 * ((prediction - target) ** 2).mean;
}
