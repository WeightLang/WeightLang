wgt 0.5
# 先创建仓库 weights/native_training 目录；已有输出会被拒绝覆盖。
# 这是两点线性回归的合成训练，模型输出和优化器断点分别保存。
fn main() {
    let model = mlp([1, 1], "identity", 42, "adam");
    let loss = 0;
    for step in range(0, 300) {
        # 两行分别是两个样本，唯一特征轴宽度 1；拟合 y=2x+1。
        loss = fit(model, [[-1], [1]], [[-1], [3]], 0.05, "mse");
    }
    assert loss < 0.0001, "linear regression did not converge";
    save checkpoint model to "../../../weights/native_training/checkpoint.json";
    save model model to "../../../weights/native_training/model.json";
    let resumed = load checkpoint from "../../../weights/native_training/checkpoint.json";
    # 相同后续批次下，恢复模型必须延续同一个 Adam 步数和矩状态。
    fit(model, [[0.5]], [[2]], 0.05, "mse");
    fit(resumed, [[0.5]], [[2]], 0.05, "mse");
    assert(model([0.25]) == resumed([0.25]), "resume mismatch");
    metric("loss_before_save", loss);
    return resumed([0.25]);
}
