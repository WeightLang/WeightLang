wgt 0.5
model Categories
# 唯一轴是三个互斥类别；输入也有三个分数，不包含批次轴。
input x: f32[3]
output scores: logits[3]
# 恒等模型没有可训练权重；构造只初始化会话，本例没有执行训练。
fn forward(x) { return x; }
# loss 的 prediction 保留 logits 类型；直接 log_softmax 避免先 softmax 再 log 的下溢。
fn loss(prediction, target) { return -sum(log_softmax(prediction) * target); }
fn convert(scores) {
    # 普通函数参数保留类别类型；三个类别分数转换为和为 1 的三个概率。
    return scores.probabilities;
}
fn main() {
    let net = Categories("adam");
    let p = convert(net([1000, 1000, -1000]));
    assert(p == p.probabilities, "probabilities conversion must preserve values");
    assert(p[0] == 0.5 && p[1] == 0.5 && p[2] == 0, "stable softmax");
    seed(7);
    # 离散抽样只读 forward，不建立梯度 tape，每次消耗一次脚本 RNG。
    let action = sample from net([1000, 1000, -1000]);
    return [p, action];
}
