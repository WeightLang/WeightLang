wgt 0.5
# 此脚本在解释和编译模式下共用同一训练实现；编译本身不初始化权重。
# 输出路径相对脚本目录，先在仓库根目录创建 weights/native_script。
fn main() {
    # 输入/输出均为单特征向量；线性模型从确定性随机权重开始学习 y=2x+1。
    let model = mlp([1, 1], "identity", 42, "adam");
    let loss = 0;
    for step in range(0, 300) {
        # 每批三个样本共享同一组参数；MSE 同时对样本和输出维度平均。
        loss = fit(model, [[-1], [0], [1]], [[-1], [1], [3]], 0.05, "mse");
    }
    assert loss < 0.0001, "training failed";
    metric("training_loss", loss);
    # 权重与优化器由脚本显式保存；编译器不决定模型输出位置、不自动导出。
    save_model(model, "../../../weights/native_script/model.json");
    save_checkpoint(model, "../../../weights/native_script/checkpoint.json");
    return model([0.25]);
}
