wgt 0.5
# 能力输入是一个数值列表，返回精确表达式结果；没有神经权重和隐式训练。
fn sum_squares(values) {
    let total = 0;
    for value in values { total = total + value * value; }
    return total;
}
fn exhausted() { while true { let value = 1; } }
fn main() {
    compute_budget(10000, 4096, 10, 10000);
    # 九维子额度：工作量、工作区、调用数、毫秒、读、写、存储、网络正文、请求数。
    # 自定义计算没有 I/O 需求，后五项为 0；额度只从父任务分配。
    compute_register("user.sum_squares.v1", "sum_squares", [1000, 4096, 2, 1000, 0, 0, 0, 0, 0]);
    let result = compute_call("user.sum_squares.v1", [3, 4]);
    assert(result["ok"] && result["value"] == 25, "custom capability failed");
    # 子任务耗尽自身工作量后返回失败，父任务仍能检查结果并继续。
    let failed = compute_scope("exhausted", [], [10, 4096, 1, 1000, 0, 0, 0, 0, 0]);
    assert(!failed["ok"] && failed["work"] == 10, "scope did not contain exhaustion");
    metric("trace", compute_trace());
    return result["value"];
}
