wgt 0.5
# 策略输入为 [任务是否需要精确计算, 剩余工作量比例]，输出两个动作 logits。
# 动作 0 返回已知常量，动作 1 调用精确求和；这是小型路由教学任务。
# 网络初始为随机权重，下方显式监督训练后才用于决策。
fn main() {
    compute_budget(10000, 4096, 10, 60000);
    let policy = mlp([2, 8, 2], "tanh", 42, "adam");
    for step in range(0, 300) {
        # 所有轮次共享同一策略参数；目标为两个动作的分类标签。
        fit(policy, [[0, 1], [1, 1]], [0, 1], 0.02, "cross_entropy");
    }
    let budget = compute_status();
    let scores = predict(policy, [1, budget["work_remaining"] / 10000]);
    assert(scores[1] > scores[0], "policy did not learn routing");
    if scores[0] >= scores[1] { return 0; }
    let result = compute_call("integer_sum.v1", [100, 200, 300]);
    assert(result["ok"], "host computation failed");
    metric("host_work", result["work"]);
    metric("trace", compute_trace());
    return result["value"];
}
