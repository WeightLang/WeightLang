wgt 0.5
model Policy
input observation: f32[1]
output prediction: f32[1]
# 一个标量观测轴与一个标量预测轴；初始化权重1，learner显式执行后才训练。
parameter weight: f32[1] = [1]
fn forward(observation) { return weight * observation; }
fn loss(prediction, target) { return square(prediction-target).mean; }

# agent保留传入模型的别名，声明不构造模型或执行学习；critic可另行显式声明。
agent Predictor {
    policy;
    learner: update;
}
# feedback是普通向量，此监督例子不要求奖励或PPO算法。
environment Counter {
    observation: f32[1];
    action: f32[1];
    feedback: f32[1];
    reset: reset_counter;
    step: step_counter;
}
fn reset_counter(state, seed) {
    # 初始标量状态由构造器显式给出；reset后恢复初态。
    return {state: state, observation: [state]};
}
fn step_counter(state, action) {
    let next = state + action[0];
    return {state: next, observation: [next], feedback: [0], terminated: next >= 3, truncated: false};
}
fn update(actor, batch) {
    let policy = actor.policy;
    # 记录列在同一范围切分，模型仍只接收显式tensor输入和现有loss目标。
    for part in batch size 2 {
        train policy on (part.observation, part.target) rate 0.1 clip 1;
    }
    return len(batch);
}
fn main() {
    let policy = Policy("sgd");
    let actor = Predictor(policy);
    # 构造执行一次reset；实例state与seed隔离，不启动隐式训练。
    let env = Counter(0, 7);
    let report = learn actor {
        for i in range(0, 3) {
            let transition = env.step([1]);
            yield {observation: transition.observation, target: transition.feedback};
        }
    };
    assert(report == 3, "learner sample count");
    assert(policy([1])[0] < 1, "explicit learner did not update policy");
    # terminated/truncated都需要reset才可继续step，但算法仍可区分两标志做bootstrap。
    assert(env.reset() == [0], "environment reset");
    return report;
}
