wgt 0.3
model dora_demo
# 每个样本有 8 个输入特征，投影到 5 个输出特征；batch 轴由 Python 提供。
input x: f32[8]
output y: f32[5] from projection
layer projection: linear(in=8,out=5)
# 方向由低秩 A/B 调整，magnitude 为每个输出特征学习独立幅度。
# rank=3 是低秩中间轴；alpha/rank=2。仅冻结本层基础 weight/bias。
# 此例只初始化，未加载预训练权重，也未训练；训练循环见 train.py。
adapter task: dora target=projection rank=3 alpha=6 freeze=1
init seed=7
