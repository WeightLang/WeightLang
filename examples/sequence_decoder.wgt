wgt 0.3
# 小型初始化解码器；time 是 token 位置，batch 不在源码形状里。没有训练数据或已训练权重。
model sequence_decoder
input tokens: i64[time=4]
output logits: f32[time=4, 13]
layer embed: embedding(vocab=13, dim=8)
# Q/K 按头归一化，两个 Q 头共享一个 K/V 头；显式序列接口可接 mask 和缓存。
layer attention: rope_attention(dim=8, heads=2, kv_heads=1, head_dim=4, qk_norm=1, max_len=32, norm_cast_after=1, rope_fp32=1)
# 三个独立专家，每个 token 选择两个；训练需把 run_sequence 返回的 aux_loss 加入目标。
layer experts: sparse_moe(dim=8, hidden=12, experts=3, top_k=2)
# 共享第一个 embedding 的矩阵，用其转置方向将隐藏特征投影成词表 logits。
layer head: linear(in=8, out=13, bias=0, tie_embedding=1)
init seed=5
