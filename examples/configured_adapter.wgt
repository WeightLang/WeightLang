wgt 0.3
model configured_adapter
# Python 通过 config 覆盖宽度；编译和打包固定其最终值。
config WIDTH: int default=4 min=2 max=16
require WIDTH % 2 == 0
input x: f32[WIDTH]
output y: f32[WIDTH] from projection
layer projection: linear(in=WIDTH,out=WIDTH)
# 身份与层路径分离；重命名层时保留这两个名字以迁移训练断点。
parameter kernel = projection.weight
parameter offset = projection.bias
# 基础参数冻结，只有 A/B 可训练。B 初始化为零，不代表已经训练。
adapter task: lora target=projection rank=2 alpha=4
init seed=7
