wgt 0.2
# Architecture and initialization; train.py trains this module on binary MNIST data.
# Pixels are flattened row-major and divided by 255, with white ink on black.
model mnist
input pixels: f32[784]
output logits: f32[10]
layer hidden1: linear(in=784, out=128)
layer relu1: relu
layer hidden2: linear(in=128, out=64)
layer relu2: relu
layer classifier: linear(in=64, out=10)
init seed=42
