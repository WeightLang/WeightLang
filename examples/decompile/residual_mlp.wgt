wgt 0.3
model ResidualMLP
# 静态转换 Python 定义，未执行源码；没有导入权重，构建时重新初始化。
# 输入形状不含 batch；Linear 作用于最后一维，卷积输入为 channel,height,width。
input x: f32[8]
output y: f32[8]
# 每个参数层独立；分支显式引用输入，add/mul 不进行广播。
layer n0_ResidualMLP_up: linear(in=8, out=16) from input
layer n1_ResidualMLP_norm: layernorm(dim=16) from n0_ResidualMLP_up
layer n2_gelu: gelu from n1_ResidualMLP_norm
layer n3_ResidualMLP_down: linear(in=16, out=8) from n2_gelu
layer n4_value: add(n3_ResidualMLP_down, input)
init seed=0
