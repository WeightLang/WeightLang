wgt 0.3
model StackedMLP
# 静态转换 Python 定义，未执行源码；没有导入权重，构建时重新初始化。
# 输入形状不含 batch；Linear 作用于最后一维，卷积输入为 channel,height,width。
input x: f32[8]
output y: f32[2]
# 每个参数层独立；分支显式引用输入，add/mul 不进行广播。
layer n0_StackedMLP_blocks_0_projection: linear(in=8, out=8) from input
layer n1_StackedMLP_blocks_0_activation: tanh from n0_StackedMLP_blocks_0_projection
layer n2_value: add(n1_StackedMLP_blocks_0_activation, input)
layer n3_StackedMLP_blocks_1_projection: linear(in=8, out=8) from n2_value
layer n4_StackedMLP_blocks_1_activation: tanh from n3_StackedMLP_blocks_1_projection
layer n5_value: add(n4_StackedMLP_blocks_1_activation, n2_value)
layer n6_StackedMLP_blocks_2_projection: linear(in=8, out=8) from n5_value
layer n7_StackedMLP_blocks_2_activation: tanh from n6_StackedMLP_blocks_2_projection
layer n8_value: add(n7_StackedMLP_blocks_2_activation, n5_value)
layer n9_StackedMLP_output: linear(in=8, out=2) from n8_value
init seed=0
