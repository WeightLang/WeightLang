wgt 0.3
use std/transformer as t
const WIDTH = 32
model gated_transformer
input tokens: i64[16]
output logits: f32[16,128]
layer tokens: t.tokens(vocab=128, dim=WIDTH, max_len=16)
layer decoder: repeat(4, t.gated_decoder(dim=WIDTH, heads=4))
layer head: layernorm(dim=WIDTH) -> linear(in=WIDTH, out=128)
init seed=42
