wgt 0.3
const WIDTH = 4
model syntax_sugar
# time 是三个观测时刻，feature 是每个时刻的四个特征；形状不含 batch。
input x: f32[time=3, feature=WIDTH]
output y: f32[feature=WIDTH]
# 两个分支独立学习投影，各自跨时间共享权重。sigmoid 将门限制在 (0,1)。
layer gate: linear(WIDTH) -> sigmoid from input
layer value: linear(WIDTH) from input
# 逐元素门控和跳连要求完整形状相同，不做广播；结果仍是 [3,4]。
layer selected: gate * value
layer skip: selected + value
# 匿名管线先扩展再压回四个特征，与输入相加；参数路径为 ff.step0/step2。
layer ff: residual(linear(WIDTH * 2) -> gelu -> linear(WIDTH))
# [time=3,feature=4] -> [feature=4,time=3]，仅交换轴，不新增权重。
layer swapped: transpose(feature, time)
# 沿时间轴取平均，保留四个特征：[4,3] -> [4]。
layer pooled: mean(axis=time)
# 这里只初始化结构，没有训练，不代表已具备预测能力。
init seed=42
