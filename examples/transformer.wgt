wgt 0.3
# Small next-token smoke test on a repeating synthetic sequence, not a pretrained LLM.
use std/transformer
use std/heads
model tiny_transformer
input tokens: i64[4]
output logits: f32[4, 4]
layer embed: transformer.tokens(vocab=4, dim=8, max_len=4)
layer body: transformer.decoder(dim=8, heads=2, hidden=16)
layer norm: layernorm(dim=8)
layer head: heads.classifier(in=8, classes=4)
data cycles:
  [0, 1, 2, 3] -> [1, 2, 3, 0]
  [1, 2, 3, 0] -> [2, 3, 0, 1]
  [2, 3, 0, 1] -> [3, 0, 1, 2]
  [3, 0, 1, 2] -> [0, 1, 2, 3]
init seed=42
train data=cycles loss=cross_entropy optimizer=adamw lr=0.02 epochs=80
