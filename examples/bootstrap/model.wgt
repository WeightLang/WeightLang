wgt 0.3
use std/transformer as t
const VOCAB = 264
const CONTEXT = 384
const WIDTH = 64
model bootstrap_lm
# 时间轴为 UTF-8 字节及独立角色标记，batch 不写在单样本接口内。
# 0/1/2 为 PAD/BOS/EOS；3..258 为字节；259..263 为角色和消息结束标记。
input tokens: i64[CONTEXT]
output logits: f32[CONTEXT,VOCAB]
# 每个位置由字节嵌入和可学习位置编码共同表示：[384] -> [384,64]。
layer embedding: t.tokens(vocab=VOCAB, dim=WIDTH, max_len=CONTEXT)
# 两层各有独立权重，各层跨时间共享参数；因果注意力禁止读取未来答案。
# 四头每头 16 维。SwiGLU 用门控制特征，残差保持 [384,64]。
layer decoder: repeat(2, t.gated_decoder(dim=WIDTH, heads=4, hidden=128))
# 输出下一 token 的原始分数；训练只监督答案和 EOS，不监督提示或 PAD。
layer head: layernorm(dim=WIDTH) -> linear(in=WIDTH, out=VOCAB)
# 此文件仅初始化；train.py 使用明确标记的合成 WGT 任务训练。
init seed=42
