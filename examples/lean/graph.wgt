wgt 0.3
model lean_graph
# 单样本是特征向量；Python 提供 batch，各行共享同一组参数。
input x: f32[3]
output y: f32[3]
# up: [3] -> [4]；独立 [out,in] 权重。
layer n0: linear(in=3,out=4,bias=1) from input
# square: 同宽分支逐元素相乘（乘法门控，不限制值域）；重复引用复用已有计算和参数。
layer n1: mul(n0, n0)
# down: [4] -> [3]；独立 [out,in] 权重。
layer n2: linear(in=4,out=3,bias=0) from n1
# skip: 同宽分支相加（可用于残差）；重复引用复用已有计算和参数。
layer n3: add(n2, input)
# 仅初始化，未训练；数据和优化器由 Python 管理。
init seed=0
