wgt 0.3
model debug_weights
input x: f32[1]
output prediction: f32[1]
# 单样本只有一个数值特征；运行时形状为 [batch,1]，线性层保持该形状。
# 用 y=2*x+1 的合成数据观察权重和偏置是否朝预期方向更新。
layer fit: linear(in=1,out=1)
init seed=42
# 此文件声明结构和训练任务；尚未执行 build 时没有训练好的权重。
data train:
  [0] -> [1]
  [1] -> [3]
  [2] -> [5]
train data=train loss=mse optimizer=sgd lr=0.05 epochs=20 batch=3
# build 后用 debug --weights weights/debug_weights 检查实际保存的参数。
# 调试更新只在内存里发生；它不是保存新模型或评估泛化能力的命令。
