wgt 0.3
use std/transformer as t
const VOCAB = 47
const WIDTH = 64
const CONTEXT = 48
model tiny_char_lm
# 单样本最多 48 个字符位置，batch 由运行时添加；0/1/2 为 PAD/BOS/EOS。
# VOCAB 必须与 data.py 的字符表一致。本例不支持任意中文输入。
input tokens: i64[CONTEXT]
output logits: f32[CONTEXT,VOCAB]
# 字符嵌入加可学习位置编码：[48] -> [48,64]。
layer embedding: t.tokens(vocab=VOCAB, dim=WIDTH, max_len=CONTEXT)
# 两层独立权重；每层内部在时间位置之间共享投影权重。
# 因果注意力只读取当前位置及其之前的字符，不能偷看训练目标。
# 四个注意力头每头 16 维；残差保持 [48,64]，MLP 中间扩为 128 维。
layer decoder: repeat(2, t.decoder(dim=WIDTH, heads=4, hidden=128))
# 每个位置给出下一个字符的 47 个原始分数；训练交叉熵不预先 softmax。
layer head: layernorm(dim=WIDTH) -> linear(in=WIDTH, out=VOCAB)
# 此文件只初始化结构。train.py 使用合成语料训练并保存完整 trained 制品。
init seed=42
