wgt 0.3
model multiscale
input image: f32[3,8,8]
output y: f32[2,8,8]

# 单样本轴为 channels,height,width；batch 不写入 shape。
# 保留浅层 [4,8,8] 细节，另一路降到 [4,4,4] 提取低分辨率特征。
layer shallow: conv2d(in=3,out=4,kernel=3,padding=1) -> relu
layer down: avgpool2d(kernel=2,stride=2)
layer deep: conv2d(in=4,out=4,kernel=3,padding=1) -> relu
# 双线性插值恢复 8x8；沿 channel 拼接浅层跳连，成为 [8,8,8]。
layer up: resize2d(height=8,width=8,mode=1,align_corners=0)
layer fused: cat(axis=0) from shallow,up
# [8,8,8] -> [2,8,8] 输出两通道原始值；仅初始化，未训练。
layer head: conv2d(in=8,out=2,kernel=1)
init seed=42
