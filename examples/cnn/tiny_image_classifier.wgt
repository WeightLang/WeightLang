wgt 0.5
model TinyImageCNN
input image: f32[64]
output logits: f32[3]

# Channel-first image: [1, 8, 8].
# Conv1: [1,8,8] -> [4,4,4], using stride 2 and symmetric padding 1.
parameter conv1_kernel: f32[4,1,3,3] = [-0.175, 0.07, -0.28, -0.035, 0.21, -0.14, 0.105, -0.245, 0, 0.245, -0.105, 0.14, -0.21, 0.035, 0.28, -0.07, 0.175, -0.175, 0.07, -0.28, -0.035, 0.21, -0.14, 0.105, -0.245, 0, 0.245, -0.105, 0.14, -0.21, 0.035, 0.28, -0.07, 0.175, -0.175, 0.07]
parameter conv1_bias: f32[4] = [0.01, -0.02, 0.015, -0.005]

# Conv2: [4,4,4] -> [4,2,2].
parameter conv2_kernel: f32[4,4,3,3] = [0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036, -0.144, -0.018, 0.108, -0.072, 0.054, -0.126, 0, 0.126, -0.054, 0.072, -0.108, 0.018, 0.144, -0.036, 0.09, -0.09, 0.036]
parameter conv2_bias: f32[4] = [0.01, 0.0, -0.01, 0.005]

# Flattened feature width is 4 * 2 * 2 = 16.
parameter classifier_weight: f32[3,16] = [-0.1, 0.075, -0.175, 0, 0.175, -0.075, 0.1, -0.15, 0.025, 0.2, -0.05, 0.125, -0.125, 0.05, -0.2, -0.025, 0.15, -0.1, 0.075, -0.175, 0, 0.175, -0.075, 0.1, -0.15, 0.025, 0.2, -0.05, 0.125, -0.125, 0.05, -0.2, -0.025, 0.15, -0.1, 0.075, -0.175, 0, 0.175, -0.075, 0.1, -0.15, 0.025, 0.2, -0.05, 0.125, -0.125, 0.05]
parameter classifier_bias: f32[3] = [0.02, -0.01, 0.0]

fn forward(image) {
    let image2d = reshape(image, [1, 8, 8]);
    let conv1 = conv(image2d, conv1_kernel, conv1_bias, [2, 2], [1, 1], [1, 1], 1);
    let features1 = relu(conv1);

    let conv2 = conv(features1, conv2_kernel, conv2_bias, [2, 2], [1, 1], [1, 1], 1);
    let features2 = relu(conv2);

    let flattened = reshape(features2, [16]);
    return linear(flattened, classifier_weight, classifier_bias);
}

fn loss(prediction, target) {
    return square(prediction - target).mean;
}
