wgt 0.3
const STEPS = 4
const FEATURES = 8
const HEADS = 2
model dimensions
# time 是单个样本的时间步；feature 是每步的特征，batch 不写进端口。
input x: f32[time=STEPS, feature=FEATURES]
output y: f32[feature=FEATURES]

# 每个时间步共用一套线性权重：[4,8] -> [4,8]；in 从最后一维推导。
# gate 和 value 是两个独立层，各自拥有权重。sigmoid 门决定各位置保留多少值。
layer gate: linear(out=FEATURES) -> sigmoid from input
layer value: linear(out=FEATURES) from input
# 两支完整形状相同，逐元素相乘，不会把一个标量门自动广播到全部特征。
layer gated: mul(gate, value)

# [time=4,feature=8] -> [feature=8,time=4] -> [time=4,feature=8]。
# 显式调换轴再还原，数值不会被训练或聚合；轴名必须与已知输入名称相符。
layer transposed: rearrange("time feature -> feature time")
layer restored: rearrange("feature time -> time feature")
# 把 8 个特征拆成 2 组、每组 4 个值，再将 head 移到首轴：[4,8] -> [2,4,4]。
# 这里只分组与重排，不是注意力，也不会给各 head 创建独立权重。
layer heads: rearrange("time (head width) -> head time width", head=HEADS)
# 合并回 [4,8]；组合轴 (head width) 的名称未知，不会自动命名为 feature。
layer joined: rearrange("head time width -> time (head width)")
# 未知轴可由此模式命名为 feature；对 time 求平均，[4,8] -> [8]。
# 改为 op=sum 则保留总量，输出形状相同，但数值会是均值的 STEPS 倍。
layer pooled: reduce("time feature -> feature", op=mean)

# 无数据集、无 train：只有可训练参数的初始化结构，权重尚未训练。
# 随机或合成输入仅能验证形状和梯度，不能证明实际任务效果。
init seed=42
