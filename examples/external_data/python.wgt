wgt 0.3
model external_python
# 每个样本一个输入、一个输出；linear 仅拟合 y=a*x+b，不包含预训练权重。
input x: f32[1]
output y: f32[1]
layer fit: linear(out=1)
init seed=42
# check 不运行这两个函数；build 才加载合成数据并设置已知回归参数。
# 这是接口演示，设置合成规则的参数不代表真实数据上的训练质量。
data samples: python="hooks.py:load"
train data=samples loss=mse epochs=1 python="hooks.py:train"
