# /// script
# [dependencies]
# "github.com/WeightLang/WeightLang/packages/gates" = "v0.5.0"
# "github.com/WeightLang/WeightLang/packages/iris" = "v0.5.0"
# ///
wgt 0.5
# 使用已训练包中的推理模型，不执行包源码里的训练 main。
fn main() {
    let gates = dependency("github.com/WeightLang/WeightLang/packages/gates");
    let xor = model(gates + "/xor_mlp/model.json", "sgd");
    # 两个布尔特征映射到单个 sigmoid 概率；四个样本共享已训练权重。
    let samples = [[0,0], [0,1], [1,0], [1,1]];
    let labels = [0,1,1,0];
    for i in range(0, 4) {
        let probability = predict(xor, samples[i])[0];
        assert((probability > 0.5) == (labels[i] == 1), "XOR package prediction failed");
    }
    let iris_path = dependency("github.com/WeightLang/WeightLang/packages/iris");
    let iris = model(iris_path + "/iris/model.json", "sgd");
    # 输入依次为萼片长宽、花瓣长宽（厘米）；输出为三个物种的未归一化 logits。
    # 这里只验证已知样本的推理，不运行训练，也不改动模型权重。
    let scores = predict(iris, [5.1,3.5,1.4,0.2]);
    assert(scores[0] > scores[1] && scores[0] > scores[2], "Iris package prediction failed");
    metric("xor_correct", 4);
    return scores;
}
