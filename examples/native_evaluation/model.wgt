wgt 0.5
model Regression
# 每个样本只有一个特征，f32[1] -> f32[1]；样本轴由 fit 的外层列表提供。
input x: f32[1]
output y: f32[1]
layer output: linear(out=1)
init seed=42

fn main() {
    # 初始化不是训练；300 步共享同一组权重，学习 y=2x+1。
    let net = Regression("adam");
    for step in range(0, 300) {
        fit(net, [[-1], [0], [1]], [[-1], [1], [3]], 0.05, "mse");
    }
    # 只有显式运行本入口才写模型；拒绝覆盖已有实验产物。
    save_model(net, "../../weights/native_evaluation/model.json");
    save(net, "../../weights/native_evaluation/checkpoint.json");
    return predict(net, [0.25]);
}
