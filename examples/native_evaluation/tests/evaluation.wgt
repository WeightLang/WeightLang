wgt 0.5
fn test_dataset_mse() {
    # 加载已经训练的单特征回归模型，不调用训练入口，不产生模型文件。
    let net = load_model("../../../weights/native_evaluation/model.json", "sgd");
    let reader = jsonl("../evaluation.jsonl");
    let rows = batch(reader, 2);
    let total = 0;
    let count = 0;
    while len(rows) > 0 {
        for row in rows {
            # 单样本 input/target 均为 [1]，先归约输出轴，再平均数据集样本轴。
            total = total + mse(net(row["input"]), row["target"]);
            count = count + 1;
        }
        rows = batch(reader, 2);
    }
    close(reader);
    assert(count > 0, "evaluation dataset must be nonempty");
    metric("evaluation_mse", total / count);
    assert(total / count < 0.0001, "held-out interpolation MSE exceeds threshold");
}
fn test_cpu_benchmark() {
    let net = load_model("../../../weights/native_evaluation/model.json", "sgd");
    let report = benchmark(net, [0.25], 5, 20, "cpu_forward");
    assert(report["device"] == "cpu", "explicit CPU measurement");
}
fn test_training_benchmark() {
    # 本测试独立加载权重；计时包含前向、反向、SGD 更新，更新不会保存或污染其他测试。
    let net = load_model("../../../weights/native_evaluation/model.json", "sgd");
    benchmark(net, [[[0], [1]], [[1], [3]], 0.01, "mse"], 5, 20, "cpu_train", "train:cpu");
}
