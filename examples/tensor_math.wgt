wgt 0.3
use std/tensor_math
model normalized_decay
# T 为时间轴，4 为特征轴；可带独立 batch，时间长度由输入绑定。
# 此例无可训练参数，未训练；展示旧动态前端中的数学计算如何组合为原生张量图。
dim T min=1 max=65
input x: f32[T,4]
output normalized: f32[T,4] from unit
output decay: f32[T,4] from cumulative
layer unit: tensor_math.l2norm(eps=1e-6) from x
# 用归一化特征的 softplus 生成正衰减量，累加负值后 exp；不跨 batch 或特征轴累加。
layer positive: softplus from unit
layer negative: scale(factor=-1)
layer prefix: cumsum(axis=0)
layer cumulative: exp
init seed=7
