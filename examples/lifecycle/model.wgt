wgt 0.5
model LifecycleRegression
# 单样本只有一个特征；线性层 f32[1] -> f32[1] 学习 y=2x+1。
input x: f32[1]
output y: f32[1]
layer result: linear(out=1)
init seed=42

fn main() {
    let config_reader = jsonl("run.jsonl");
    let config = batch(config_reader, 1)[0];
    close(config_reader);
    # 明确按 split 划分，训练不接触 held-out 行；数据流分批读取。
    let reader = jsonl("data.jsonl");
    let inputs = [];
    let targets = [];
    let held_out = [];
    let rows = batch(reader, 2);
    while len(rows) > 0 {
        for row in rows {
            if row["split"] == "train" {
                inputs = append(inputs, row["input"]);
                targets = append(targets, row["target"]);
            } else {
                assert(row["split"] == "test", "unknown split");
                held_out = append(held_out, row);
            }
        }
        rows = batch(reader, 2);
    }
    close(reader);
    assert(len(inputs) == 3 && len(held_out) == 2, "incorrect data split");
    # 构造仅初始化；restore 恢复 Adam 的步数及两个矩，不重置优化器。
    let net = LifecycleRegression("adam");
    if config["resume"] { net = restore("out/resume.json"); }
    let initial = 0;
    for i in range(0, len(inputs)) {
        initial = initial + mse(predict(net, inputs[i]), targets[i]);
    }
    initial = initial / len(inputs);
    # 所有步共享参数；外层样本轴为 3，fit 对样本和输出轴平均 MSE。
    for step in range(0, config["steps"]) {
        fit(net, inputs, targets, 0.05, "mse");
    }
    let final = 0;
    for i in range(0, len(inputs)) {
        final = final + mse(predict(net, inputs[i]), targets[i]);
    }
    final = final / len(inputs);
    assert(final < initial * 0.01, "loss must decrease by at least 99 percent");
    let evaluation = 0;
    for row in held_out {
        evaluation = evaluation + mse(predict(net, row["input"]), row["target"]);
    }
    evaluation = evaluation / len(held_out);
    if config["complete"] { assert(evaluation < 0.000001, "held-out MSE too high"); }
    metric("initial_loss", initial);
    metric("final_loss", final);
    metric("held_out_mse", evaluation);
    metric("prediction", predict(net, [0.25]));
    # 推理 IR 与含优化器的训练断点分开；只显式执行 main 才写入。
    save_model(net, "out/model.json");
    save(net, "out/checkpoint.json");
    # build 要求模型句柄；run/AOT 的 JSON 报告只能返回普通数值。
    if config["build"] { return net; }
    return predict(net, [0.25]);
}
