wgt 0.3
model scalar_and_empty
# 允许空 token 集合；sum 的单位元为零，最终输出是每样本标量。
dim T min=0 max=8
input tokens: f32[T,4]
input gain: f32[]
output score: f32[] from scaled
# 投影在所有时间步共享同一权重。这里仅初始化，未训练。
layer projected: linear(in=4,out=2)
layer features: reduce_sum(axis=1)
layer total: reduce_sum(axis=0)
# gain 必须与 tokens 的 batch 对齐；不会把一个标量暗中广播到整个 batch。
layer scaled: mul(total,gain)
init seed=7
