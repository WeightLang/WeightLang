wgt 0.3
model classifier
# 单样本四个特征；Python 输入 [batch, 4]，batch 不写入端口。
input x: f32[4]
# 三个类别的原始分数，交叉熵负责归一化，不在模型末尾加 softmax。
output logits: f32[3]
# [batch, 4] -> [batch, 16]；所有样本共享投影参数。
layer hidden: linear(in=4, out=16)
layer activated: relu
layer head: linear(in=16, out=3)
# 仅初始化；数据、loss、训练循环和采样由 Python 管理。
init seed=42
