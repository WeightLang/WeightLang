wgt 0.3
model recurrent_classifier
input x: f32[8,4]
output y: f32[2]
block cell(features, hidden):
  layer joined: concat(input, state)
  layer gate: linear(in=features + hidden, out=hidden)
  layer z: sigmoid
  layer proposal: linear(in=features + hidden, out=hidden) from joined
  layer candidate: tanh
  layer next: mix(z, candidate, state)
layer memory: scan(hidden=16, cell(features=4, hidden=16))
layer final: last
layer head: linear(in=16, out=2)
init seed=42
