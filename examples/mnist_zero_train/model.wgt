wgt 0.3
model mnist_zero_train
# Python 仅将 28×28 灰度图展平并作 L2 归一化；batch 不属于这里的形状。
input pixels: f32[784]
output scores: f32[10]
# 每个数字 324 个手工笔画变体；每行是一个单位范数模板，无偏置。
# 权重完全由 init.wgt 的几何算法生成，不读取训练样本，也不更新参数。
layer templates: linear(in=784, out=3240, bias=0)
# [3240] -> [数字=10, 变体=324]；各变体独立存储，推理时共享给所有图片。
layer grouped: rearrange("(digit variant) -> digit variant", digit=10)
# 对平移、倾斜、宽度、笔画粗细和写法取最佳匹配；输出是相似度，不是概率。
layer scores: reduce_max(axis=1)
init file="init.wgt" seed=0
