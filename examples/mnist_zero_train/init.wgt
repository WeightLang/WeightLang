wgt init 1
# 人工定义 0..9 的折线笔画；知识来自数字的书写规则，不来自任何数据集。
# 坐标横向约 [-1,1]、纵向 [-1,1]。每个子列表是一笔，不连接不同笔。
algorithm strokes(digit, style):
    if digit == 0:
        return [[[-0.6,-1],[0.3,-1],[0.9,-0.6],[1,0.2],[0.6,0.9],[-0.2,1],[-0.9,0.5],[-1,-0.3],[-0.6,-1]]]
    if digit == 1:
        if style == 0:
            return [[[0,-1],[0,1]]]
        return [[[-0.6,-0.6],[0,-1],[0,1]],[[-0.6,1],[0.6,1]]]
    if digit == 2:
        return [[[-0.9,-0.6],[-0.5,-1],[0.3,-1],[0.9,-0.6],[0.8,-0.1],[0.2,0.4],[-0.9,1],[0.9,1]]]
    if digit == 3:
        if style == 0:
            return [[[-0.9,-0.8],[-0.3,-1],[0.5,-0.9],[0.9,-0.5],[0.5,-0.1],[-0.1,0],[0.5,0.1],[1,0.5],[0.6,0.9],[-0.2,1],[-0.9,0.7]]]
        return [[[-0.9,-1],[0.9,-1],[-0.1,0],[0.6,0.1],[1,0.5],[0.6,0.9],[-0.2,1],[-0.9,0.7]]]
    if digit == 4:
        if style == 0:
            return [[[-0.5,-1],[-1,0.2],[0.9,0.2]],[[0.6,-1],[0.6,1]]]
        return [[[0.6,-1],[-1,0.2],[0.9,0.2]],[[0.6,-1],[0.6,1]]]
    if digit == 5:
        return [[[0.9,-1],[-0.7,-1],[-0.9,0],[-0.2,-0.2],[0.6,-0.1],[1,0.4],[0.7,0.9],[-0.1,1],[-0.9,0.7]]]
    if digit == 6:
        return [[[0.6,-1],[-0.1,-0.9],[-0.7,-0.3],[-1,0.4],[-0.6,0.9],[0.1,1],[0.8,0.6],[0.8,0.1],[0.3,-0.2],[-0.4,-0.1],[-0.9,0.3]]]
    if digit == 7:
        if style == 0:
            return [[[-1,-1],[1,-1],[0.2,0],[-0.4,1]]]
        return [[[-1,-1],[1,-1],[0.2,0],[-0.4,1]],[[-0.5,0],[0.7,0]]]
    if digit == 8:
        return [[[0,-0.1],[-0.7,-0.5],[-0.6,-0.9],[0.1,-1],[0.7,-0.7],[0.6,-0.3],[0,-0.1],[-0.8,0.3],[-0.9,0.7],[-0.3,1],[0.5,0.9],[0.9,0.5],[0.6,0.2],[0,-0.1]]]
    return [[[0.8,-0.3],[0.5,-0.9],[-0.2,-1],[-0.9,-0.7],[-1,-0.2],[-0.5,0.2],[0.2,0.1],[0.8,-0.3],[0.6,0.4],[0.1,1]]]

algorithm render(digit, style):
    # 一次向量化生成 162 个变体：[变体, 像素]，不用逐像素循环。
    let v = reshape(arange(162), [162,1])
    let p = reshape(arange(784), [1,784])
    let dx = v % 3 - 1
    let dy = (v // 3) % 3 - 1
    let width = 5 + 2 * ((v // 9) % 3)
    let slant = 0.2 * ((v // 27) % 3 - 1)
    let sigma = 0.85 + 0.45 * ((v // 81) % 2)
    let y = p // 28 - 13.5 - dy
    let x = p % 28 - 13.5 - dx - slant * y
    let distance = full([162,784], 10000)
    # 到各线段的最短距离决定墨迹强度；clamp 把投影限制在线段内。
    for stroke in strokes(digit, style):
        for i in range(len(stroke) - 1):
            let ax = stroke[i][0] * width
            let ay = stroke[i][1] * 9
            let bx = stroke[i+1][0] * width
            let by = stroke[i+1][1] * 9
            let vx = bx - ax
            let vy = by - ay
            let t = clamp(((x-ax)*vx + (y-ay)*vy) / (vx*vx + vy*vy), 0, 1)
            let d = (x-ax-t*vx)**2 + (y-ay-t*vy)**2
            distance = minimum(distance, d)
    let ink = exp(-distance / (2 * sigma**2))
    # 单位范数避免更粗、更长的笔画仅靠墨量赢得匹配。
    return ink / sqrt(sum(ink*ink, 1, True))

tensor "templates.weight":
    let weights = zeros(shape)
    for digit in range(10):
        for style in range(2):
            let start = digit * 324 + style * 162
            weights[start:start+162, :] = render(digit, style)
    return weights
