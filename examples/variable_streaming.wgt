wgt 0.3
model variable_streaming
# T 是运行时帧数，不是占位常量。当前有限验证器检查 1..16 内的每个合法长度。
dim T min=1 max=16
# 这里只演示偶数长度约束；没有约束时，范围内所有正整数长度都合法。
require T % 2 == 0
input samples: f32[time=T,features=2]
input old: f32[hidden=4]
output states: f32[time=T,hidden=4] from memory
output new: f32[hidden=4] from final
block cell():
  # 拼接每帧的两个特征与四维旧状态，投影后仍为四维。
  # scan 的所有时间步共用此组权重，跨分块梯度是否截断由 Python 决定。
  layer joined: concat(input, state)
  layer next: linear(in=6,out=4) -> tanh
layer memory: scan(hidden=4,cell()) from samples, old
# 返回所有逐帧状态和下次调用的初态；状态不保存为模型参数。
layer final: last from memory
# 仅初始化结构；示例没有训练。
init seed=7
