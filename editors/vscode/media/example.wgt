wgt 0.5
model Regression
# 每个样本一个特征，输出一个回归值；不含 batch 轴。
input x: f32[1]
output y: f32[1]
# 隐藏层把一个特征展开到八维，最后投影回一个数值。
layer hidden: linear(out=8)
layer activation: tanh
layer result: linear(out=1)
init seed=42

fn main() {
    # 构造时仅初始化；循环各步共享同一组参数和 Adam 状态。
    let net = Regression("adam");
    for step in range(0, 100) {
        # 输入和目标均为 [样本, 特征]；仅训练这两个合成样本。
        fit(net, [[0], [1]], [[1], [3]], 0.03, "mse");
    }
    return net([1]);
}
