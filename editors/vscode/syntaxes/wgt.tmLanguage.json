{
  "name": "WeightLang",
  "scopeName": "source.wgt",
  "fileTypes": [
    "wgt"
  ],
  "patterns": [
    {
      "name": "meta.torch.model.wgt",
      "begin": "^target\\s+torch\\s*$",
      "end": "(?!)",
      "patterns": [
        {
          "include": "#torch_extensions"
        },
        {
          "include": "$self"
        }
      ]
    },
    {
      "name": "comment.line.number-sign.wgt",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.wgt",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.wgt",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    {
      "match": "\\b(native)\\s+(fn|intrinsic)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "storage.type.function.wgt"
        },
        "3": {
          "name": "entity.name.function.wgt"
        }
      }
    },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "entity.name.function.wgt"
        }
      }
    },
    {
      "match": "\\b(model|operators)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "entity.name.type.wgt"
        }
      }
    },
    {
      "name": "meta.tensor.shape.wgt",
      "begin": "(\\bas)\\s*(\\[)",
      "end": "\\]|(?=[;{}])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "punctuation.wgt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.wgt"
        }
      },
      "patterns": [
        {
          "include": "#shape"
        }
      ]
    },
    {
      "name": "meta.tensor.shape.wgt",
      "begin": "(\\b(?:f32|logits|probabilities))\\s*(\\[)",
      "end": "\\]|(?=[;{}])",
      "beginCaptures": {
        "1": {
          "name": "storage.type.wgt"
        },
        "2": {
          "name": "punctuation.wgt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.wgt"
        }
      },
      "patterns": [
        {
          "include": "#shape"
        }
      ]
    },
    {
      "match": "(\\.)(T|mean|probabilities)\\b(?!\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.wgt"
        },
        "2": {
          "name": "support.variable.property.wgt"
        }
      }
    },
    {
      "name": "meta.binding.tuple.wgt",
      "begin": "(\\blet)\\s*(\\()",
      "end": "\\)|(?=[;=])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "punctuation.wgt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.wgt"
        }
      },
      "patterns": [
        {
          "name": "variable.other.wgt",
          "match": "\\b[A-Za-z_]\\w*\\b"
        },
        {
          "name": "punctuation.wgt",
          "match": ","
        },
        {
          "name": "comment.line.number-sign.wgt",
          "match": "#.*$"
        }
      ]
    },
    {
      "name": "support.function.wgt",
      "match": "(?<![\\w.])(?:append|argmax|argmin|argsort|batch|bce_logits|benchmark|clip|close|column|commit_gradients|compress|compute_budget|compute_call|compute_capabilities|compute_host_status|compute_register|compute_scope|compute_status|compute_trace|concat|cosine_similarity|cross_entropy|cross_entropy_probs|cumsum|dependency|device_status|device_submit|device_wait|devices|diff|differentiate|differentiate_at|dot|elu|ema|entropy|execution_cancel|execution_resume|execution_start|exp|expm1|fma|full|gae|gather|gradient_snapshot|hard_sigmoid|hard_swish|hf_dataset|huber|hypot|js_divergence|jsonl|kl_divergence|l2_normalize|leaky_relu|len|linspace|log|log1p|log_cosh|log_softmax|logsumexp|mae|max|mean|median|metric|min|mlp|moving_mean|mse|norm|normalize_probabilities|one_hot|ones|quantile|random|range|reinforce|release_gradient|relu|responses_cancel|responses_next|responses_restrict|responses_scope|responses_session|responses_submit|responses_usage|reverse|rsqrt|seed|sigmoid|silu|softmax|softplus|sort|sqrt|stddev|sum|temperature_softmax|training_device|training_status|variance|vector_slice|wgsl_kernel|wgsl_run|zeros|add|avg_pool2d|batch_matmul|conv|depth_gate|detach|div|dynamic_slice|embedding|gate|ge|gelu|layer_norm|linear|masked_softmax|matmul|max_pool2d|memory_alloc|memory_free|memory_read|memory_write|minimum|mul|permute|positive|read|reshape|resource_state|route|scale|slice|square|tanh|topk_mask|transpose|write|eye|uniform|xavier_uniform|identity)(?=\\s*\\()"
    },
    {
      "name": "keyword.control.wgt",
      "match": "\\b(?:dim|blend|repeat|indexed|carrying|agent|environment|state|learn|as|assert|async|await|spawn|tasks|sleep|break|checkpoint|collect|continue|else|fn|for|from|frozen|if|import|in|init|input|json|layer|let|load|mix|model|onehot|operators|output|overwrite|parameter|reload|return|sample|save|size|text|then|to|train|on|against|rate|clip|target|using|wgt|while|yield|native|intrinsic)\\b"
    },
    {
      "name": "invalid.deprecated.wgt",
      "match": "\\b(?:fit|predict)\\b(?=\\s*\\()"
    },
    {
      "name": "storage.type.wgt",
      "match": "\\b(?:bool|f32|float|int|logits|prob|probabilities)\\b"
    },
    {
      "name": "constant.language.wgt",
      "match": "\\b(?:false|null|true)\\b"
    },
    {
      "name": "variable.parameter.wgt",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=(?!=))"
    },
    {
      "name": "constant.numeric.wgt",
      "match": "(?<![\\w.])-?(?:\\d+\\.(?!\\.)\\d*|\\.\\d+|\\d+)(?:[eE][-+]?\\d+)?(?!\\w|\\.(?!\\.))"
    },
    {
      "name": "entity.name.function.wgt",
      "match": "\\b[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.wgt",
      "match": "\\.\\.=|<-|->|=>|\\*\\*|==|!=|<=|>=|&&|\\|\\||[<>=!+*/%@\\-]"
    },
    {
      "name": "punctuation.wgt",
      "match": "[\\[\\](){},.:;]"
    }
  ],
  "repository": {
    "torch_extensions": {
      "patterns": [
        {
          "name": "string.quoted.single.wgt",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.wgt",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "keyword.control.wgt",
          "match": "\\b(?:host|extern|extends|elif|with|try|except|finally|raise|pass|is|not|and|or)\\b"
        },
        {
          "name": "constant.language.wgt",
          "match": "\\b(?:True|False|None)\\b"
        }
      ]
    },
    "shape": {
      "patterns": [
        {
          "name": "comment.line.number-sign.wgt",
          "match": "#.*$"
        },
        {
          "name": "entity.name.label.wgt",
          "match": "\\b[A-Za-z_]\\w*(?=\\s*=)"
        },
        {
          "name": "constant.numeric.wgt",
          "match": "(?<![\\w.])-?(?:\\d+\\.(?!\\.)\\d*|\\.\\d+|\\d+)(?:[eE][-+]?\\d+)?(?!\\w|\\.(?!\\.))"
        },
        {
          "name": "keyword.operator.wgt",
          "match": "="
        },
        {
          "name": "punctuation.wgt",
          "match": ","
        }
      ]
    }
  }
}
