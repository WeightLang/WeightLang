{
  "name": "WeightLang",
  "scopeName": "source.wgt",
  "fileTypes": [
    "wgt"
  ],
  "patterns": [
    {
      "name": "comment.line.number-sign.wgt",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.wgt",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.wgt",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "entity.name.function.wgt"
        }
      }
    },
    {
      "name": "support.function.wgt",
      "match": "(?<![\\w.])(?:add|append|argmax|argmin|argsort|assert|batch|bce_logits|benchmark|clip|close|column|commit_gradients|compress|compute_budget|compute_call|compute_capabilities|compute_host_status|compute_register|compute_scope|compute_status|compute_trace|concat|cosine_similarity|cross_entropy|cross_entropy_probs|cumsum|dependency|detach|device_status|device_submit|device_wait|devices|diff|differentiate|differentiate_at|dot|elu|ema|entropy|execution_cancel|execution_resume|execution_start|exp|expm1|fit|fma|full|gae|gate|gather|gradient_snapshot|hard_sigmoid|hard_swish|hf_dataset|huber|hypot|identity|js_divergence|jsonl|kl_divergence|l2_normalize|leaky_relu|len|linear|linspace|load_checkpoint|load_model|log|log1p|log_cosh|log_softmax|logsumexp|mae|max|mean|median|memory_alloc|memory_free|memory_read|memory_write|metric|min|minimum|mlp|model|moving_mean|mse|mul|norm|normalize_probabilities|one_hot|ones|positive|predict|quantile|random|range|read|reinforce|release_gradient|relu|resource_state|restore|reverse|route|rsqrt|save|save_checkpoint|save_model|seed|sigmoid|silu|slice|softmax|softplus|sort|sqrt|square|stddev|sum|tanh|temperature_softmax|train|training_device|training_status|variance|vector_slice|wgsl_kernel|wgsl_run|write|zeros)(?=\\s*\\()"
    },
    {
      "name": "keyword.control.wgt",
      "match": "\\b(?:agent|environment|learn|assert|async|await|spawn|tasks|sleep|break|checkpoint|collect|continue|else|fn|for|from|frozen|if|import|in|init|input|json|layer|let|load|mix|model|onehot|operators|output|overwrite|parameter|reload|return|sample|save|size|text|then|to|train|on|rate|clip|target|using|wgt|while|yield)\\b"
    },
    {
      "name": "storage.type.wgt",
      "match": "\\b(?:f32|logits|prob|probabilities)\\b"
    },
    {
      "name": "constant.language.wgt",
      "match": "\\b(?:false|null|true)\\b"
    },
    {
      "name": "variable.parameter.wgt",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=(?!=))"
    },
    {
      "name": "support.function.wgt",
      "match": "\\b(?:linear|relu|tanh|sigmoid|identity)\\b"
    },
    {
      "name": "constant.numeric.wgt",
      "match": "(?<![\\w.])-?(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][-+]?\\d+)?(?![\\w.])"
    },
    {
      "name": "entity.name.function.wgt",
      "match": "\\b[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.wgt",
      "match": "==|!=|<=|>=|&&|\\|\\||[<>=!+*/%\\-]"
    },
    {
      "name": "punctuation.wgt",
      "match": "[\\[\\](){},.:;]"
    }
  ]
}
