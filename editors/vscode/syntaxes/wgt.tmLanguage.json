{
  "name": "WeightLang",
  "scopeName": "source.wgt",
  "fileTypes": [
    "wgt"
  ],
  "patterns": [
    {
      "name": "comment.line.number-sign.wgt",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.wgt",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.wgt",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.wgt"
        },
        "2": {
          "name": "entity.name.function.wgt"
        }
      }
    },
    {
      "name": "storage.type.function.wgt",
      "match": "\\bnative\\s+(fn|intrinsic)\\b",
      "captures": {
        "1": {
          "name": "storage.type.function.wgt"
        }
      }
    },
    {
      "match": "\\bnative\\s+(?:fn|intrinsic)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "entity.name.function.wgt"
        }
      }
    },
    {
      "name": "support.function.wgt",
      "match": "(?<![\\w.])(?:append|argmax|argmin|argsort|batch|bce_logits|benchmark|clip|close|column|commit_gradients|compress|compute_budget|compute_call|compute_capabilities|compute_host_status|compute_register|compute_scope|compute_status|compute_trace|concat|cosine_similarity|cross_entropy|cross_entropy_probs|cumsum|dependency|device_status|device_submit|device_wait|devices|diff|differentiate|differentiate_at|dot|elu|ema|entropy|execution_cancel|execution_resume|execution_start|exp|expm1|fma|full|gae|gather|gradient_snapshot|hard_sigmoid|hard_swish|hf_dataset|huber|hypot|js_divergence|jsonl|kl_divergence|l2_normalize|leaky_relu|len|linspace|log|log1p|log_cosh|log_softmax|logsumexp|mae|max|mean|median|metric|min|mlp|moving_mean|mse|norm|normalize_probabilities|one_hot|ones|quantile|random|range|reinforce|release_gradient|relu|responses_cancel|responses_next|responses_restrict|responses_scope|responses_session|responses_submit|responses_usage|reverse|rsqrt|seed|sigmoid|silu|softmax|softplus|sort|sqrt|stddev|sum|temperature_softmax|training_device|training_status|variance|vector_slice|wgsl_kernel|wgsl_run|zeros|add|avg_pool2d|batch_matmul|conv|depth_gate|detach|gate|layer_norm|linear|matmul|max_pool2d|memory_alloc|memory_free|memory_read|memory_write|minimum|mul|permute|positive|read|reshape|resource_state|route|scale|slice|square|tanh|transpose|write|identity)(?=\\s*\\()"
    },
    {
      "name": "keyword.control.wgt",
      "match": "\\b(?:blend|repeat|indexed|carrying|agent|environment|state|learn|assert|async|await|spawn|tasks|sleep|break|checkpoint|collect|continue|else|fn|for|from|frozen|if|import|in|init|input|json|layer|let|load|mix|model|onehot|operators|output|overwrite|parameter|reload|return|sample|save|size|text|then|to|train|on|against|rate|clip|target|using|wgt|while|yield|native|intrinsic)\\b"
    },
    {
      "name": "invalid.deprecated.wgt",
      "match": "\\b(?:fit|predict)\\b(?=\\s*\\()"
    },
    {
      "name": "storage.type.wgt",
      "match": "\\b(?:f32|logits|prob|probabilities)\\b"
    },
    {
      "name": "constant.language.wgt",
      "match": "\\b(?:false|null|true)\\b"
    },
    {
      "name": "variable.parameter.wgt",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=(?!=))"
    },
    {
      "name": "constant.numeric.wgt",
      "match": "(?<![\\w.])-?(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eE][-+]?\\d+)?(?![\\w.])"
    },
    {
      "name": "entity.name.function.wgt",
      "match": "\\b[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.wgt",
      "match": "<-|->|=>|\\*\\*|==|!=|<=|>=|&&|\\|\\||[<>=!+*/%@\\-]"
    },
    {
      "name": "punctuation.wgt",
      "match": "[\\[\\](){},.:;]"
    }
  ]
}
