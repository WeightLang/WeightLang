<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>name</key><string>WeightLang</string><key>scopeName</key><string>source.wgt</string><key>fileTypes</key><array><string>wgt</string></array><key>patterns</key><array><dict><key>name</key><string>comment.line.number-sign.wgt</string><key>match</key><string>#.*$</string></dict><dict><key>name</key><string>string.quoted.double.wgt</string><key>begin</key><string>"</string><key>end</key><string>"|$</string><key>patterns</key><array><dict><key>name</key><string>constant.character.escape.wgt</string><key>match</key><string>\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4})</string></dict></array></dict><dict><key>match</key><string>\b(fn)\s+([A-Za-z_][A-Za-z0-9_]*)</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>keyword.control.wgt</string></dict><key>2</key><dict><key>name</key><string>entity.name.function.wgt</string></dict></dict></dict><dict><key>name</key><string>storage.type.function.wgt</string><key>match</key><string>\bnative\s+(fn|intrinsic)\b</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>storage.type.function.wgt</string></dict></dict></dict><dict><key>match</key><string>\bnative\s+(?:fn|intrinsic)\s+([A-Za-z_][A-Za-z0-9_]*)</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>entity.name.function.wgt</string></dict></dict></dict><dict><key>name</key><string>support.function.wgt</string><key>match</key><string>(?&lt;![\w.])(?:append|argmax|argmin|argsort|batch|bce_logits|benchmark|clip|close|column|commit_gradients|compress|compute_budget|compute_call|compute_capabilities|compute_host_status|compute_register|compute_scope|compute_status|compute_trace|concat|cosine_similarity|cross_entropy|cross_entropy_probs|cumsum|dependency|device_status|device_submit|device_wait|devices|diff|differentiate|differentiate_at|dot|elu|ema|entropy|execution_cancel|execution_resume|execution_start|exp|expm1|fma|full|gae|gather|gradient_snapshot|hard_sigmoid|hard_swish|hf_dataset|huber|hypot|js_divergence|jsonl|kl_divergence|l2_normalize|leaky_relu|len|linspace|log|log1p|log_cosh|log_softmax|logsumexp|mae|max|mean|median|metric|min|mlp|moving_mean|mse|norm|normalize_probabilities|one_hot|ones|quantile|random|range|reinforce|release_gradient|relu|responses_cancel|responses_next|responses_restrict|responses_scope|responses_session|responses_submit|responses_usage|reverse|rsqrt|seed|sigmoid|silu|softmax|softplus|sort|sqrt|stddev|sum|temperature_softmax|training_device|training_status|variance|vector_slice|wgsl_kernel|wgsl_run|zeros|add|batch_matmul|clip|conv|depth_gate|detach|exp|gate|layer_norm|linear|log|log_softmax|matmul|mean|memory_alloc|memory_free|memory_read|memory_write|minimum|mul|permute|positive|read|relu|reshape|resource_state|route|scale|sigmoid|slice|softmax|square|sum|tanh|transpose|write|identity|linear|relu|sigmoid|tanh)(?=\s*\()</string></dict><dict><key>name</key><string>keyword.control.wgt</string><key>match</key><string>\b(?:blend|repeat|indexed|carrying|agent|environment|state|learn|assert|async|await|spawn|tasks|sleep|break|checkpoint|collect|continue|else|fn|for|from|frozen|if|import|in|init|input|json|layer|let|load|mix|model|onehot|operators|output|overwrite|parameter|reload|return|sample|save|size|text|then|to|train|on|against|rate|clip|target|using|wgt|while|yield|native|intrinsic)\b</string></dict><dict><key>name</key><string>invalid.deprecated.wgt</string><key>match</key><string>\b(?:fit|predict)\b(?=\s*\()</string></dict><dict><key>name</key><string>storage.type.wgt</string><key>match</key><string>\b(?:f32|logits|prob|probabilities)\b</string></dict><dict><key>name</key><string>constant.language.wgt</string><key>match</key><string>\b(?:false|null|true)\b</string></dict><dict><key>name</key><string>variable.parameter.wgt</string><key>match</key><string>\b[A-Za-z_][A-Za-z0-9_]*(?=\s*=(?!=))</string></dict><dict><key>name</key><string>constant.numeric.wgt</string><key>match</key><string>(?&lt;![\w.])-?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?(?![\w.])</string></dict><dict><key>name</key><string>entity.name.function.wgt</string><key>match</key><string>\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*(?=\s*\()</string></dict><dict><key>name</key><string>keyword.operator.wgt</string><key>match</key><string>&lt;-|-&gt;|=&gt;|\*\*|==|!=|&lt;=|&gt;=|&amp;&amp;|\|\||[&lt;&gt;=!+*/%@\-]</string></dict><dict><key>name</key><string>punctuation.wgt</string><key>match</key><string>[\[\](){},.:;]</string></dict></array></dict></plist>
