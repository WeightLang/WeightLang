<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>name</key><string>WeightLang</string><key>scopeName</key><string>source.wgt</string><key>fileTypes</key><array><string>wgt</string></array><key>patterns</key><array><dict><key>name</key><string>comment.line.number-sign.wgt</string><key>match</key><string>#.*$</string></dict><dict><key>name</key><string>string.quoted.double.wgt</string><key>begin</key><string>"</string><key>end</key><string>"|$</string><key>patterns</key><array><dict><key>name</key><string>constant.character.escape.wgt</string><key>match</key><string>\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4})</string></dict></array></dict><dict><key>match</key><string>\b(fn)\s+([A-Za-z_][A-Za-z0-9_]*)</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>keyword.control.wgt</string></dict><key>2</key><dict><key>name</key><string>entity.name.function.wgt</string></dict></dict></dict><dict><key>name</key><string>support.function.wgt</string><key>match</key><string>(?&lt;![\w.])(?:add|append|assert|batch|benchmark|close|column|dependency|exp|fit|gae|gate|hf_dataset|identity|jsonl|len|linear|log|mean|metric|mlp|model|mul|one_hot|positive|predict|random|range|read|reinforce|relu|restore|route|sample|save|save_model|seed|sigmoid|slice|softmax|sqrt|square|sum|tanh|write)(?=\s*\()</string></dict><dict><key>name</key><string>keyword.control.wgt</string><key>match</key><string>\b(?:break|continue|else|fn|for|frozen|if|in|init|input|layer|let|mix|model|onehot|output|parameter|return|sample|then|wgt|while)\b</string></dict><dict><key>name</key><string>storage.type.wgt</string><key>match</key><string>\b(?:f32|prob)\b</string></dict><dict><key>name</key><string>constant.language.wgt</string><key>match</key><string>\b(?:false|null|true)\b</string></dict><dict><key>name</key><string>variable.parameter.wgt</string><key>match</key><string>\b[A-Za-z_][A-Za-z0-9_]*(?=\s*=(?!=))</string></dict><dict><key>name</key><string>support.function.wgt</string><key>match</key><string>\b(?:linear|relu|tanh|sigmoid|identity)\b</string></dict><dict><key>name</key><string>constant.numeric.wgt</string><key>match</key><string>(?&lt;![\w.])-?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?(?![\w.])</string></dict><dict><key>name</key><string>entity.name.function.wgt</string><key>match</key><string>\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*(?=\s*\()</string></dict><dict><key>name</key><string>keyword.operator.wgt</string><key>match</key><string>==|!=|&lt;=|&gt;=|&amp;&amp;|\|\||[&lt;&gt;=!+*/%\-]</string></dict><dict><key>name</key><string>punctuation.wgt</string><key>match</key><string>[\[\](){},.:;]</string></dict></array></dict></plist>
