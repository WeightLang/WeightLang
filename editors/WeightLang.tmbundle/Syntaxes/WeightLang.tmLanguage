<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>wgt</string>
	</array>
	<key>name</key>
	<string>WeightLang</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>match</key>
			<string>#.*$</string>
			<key>name</key>
			<string>comment.line.number-sign.wgt</string>
		</dict>
		<dict>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"|$</string>
			<key>name</key>
			<string>string.quoted.double.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:as|block|const|data|dim|freeze|from|import|inherit|init|input|layer|model|output|require|train|unfreeze|use|wgt)\b</string>
			<key>name</key>
			<string>keyword.control.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:bool|f32|i64)\b</string>
			<key>name</key>
			<string>storage.type.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b[A-Za-z_]\w*(?=\s*=)</string>
			<key>name</key>
			<string>variable.parameter.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?&lt;![\w.])(?:adam|adamw|add|bce|concat|conv2d|cross_entropy|dropout|embedding|flatten|gelu|globalavgpool2d|identity|last|layernorm|linear|maxpool2d|mean|meanpool|mix|mse|mul|position_embedding|rearrange|recur|reduce|relu|repeat|residual|rmsnorm|rope_attention|scale|scan|self_attention|sgd|sigmoid|silu|softmax|sparse_moe|sum|tanh|transpose|where)\b</string>
			<key>name</key>
			<string>support.function.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?&lt;![\w.])-?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?(?![\w.])</string>
			<key>name</key>
			<string>constant.numeric.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)?(?=\s*\()</string>
			<key>name</key>
			<string>entity.name.function.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>-&gt;|//|[=+*/%\-]</string>
			<key>name</key>
			<string>keyword.operator.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>[\[\](),.:]</string>
			<key>name</key>
			<string>punctuation.wgt</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>source.wgt</string>
</dict>
</plist>
