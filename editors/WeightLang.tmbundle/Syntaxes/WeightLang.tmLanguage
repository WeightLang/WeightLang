<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>wgt</string>
	</array>
	<key>name</key>
	<string>WeightLang</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>match</key>
			<string>#.*$</string>
			<key>name</key>
			<string>comment.line.number-sign.wgt</string>
		</dict>
		<dict>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"|$</string>
			<key>name</key>
			<string>string.quoted.double.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:adapter|as|block|config|const|data|dim|freeze|from|import|inherit|init|input|layer|model|output|parameter|require|return|share|train|unfreeze|use|weight|weighttype|wgt)\b</string>
			<key>name</key>
			<string>keyword.control.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b(?:bool|f32|i64)\b</string>
			<key>name</key>
			<string>storage.type.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b[A-Za-z_]\w*(?=\s*=)</string>
			<key>name</key>
			<string>variable.parameter.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?&lt;![\w.])(?:adam|adamw|add|avgpool2d|bce|broadcast|cat|concat|conv1d|conv2d|cos|cross_entropy|cumsum|dropout|embedding|eq|exp|flatten|gather|gelu|globalavgpool2d|identity|last|layernorm|linear|log|lt|masked_softmax|matmul|maxpool2d|mean|meanpool|mix|mse|mul|pad2d|ponder|position_embedding|rearrange|recur|reduce|reduce_max|reduce_mean|reduce_sum|relu|repeat|residual|resize2d|rmsnorm|rope_attention|route|rsqrt|scale|scan|scan_state|scatter_add|self_attention|seq|sgd|shift|sigmoid|silu|sin|slice|softmax|softplus|sparse_moe|square|stack|sum|tanh|transpose|transpose_axes|where)\b</string>
			<key>name</key>
			<string>support.function.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?&lt;![\w.])-?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?(?![\w.])</string>
			<key>name</key>
			<string>constant.numeric.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)?(?=\s*\()</string>
			<key>name</key>
			<string>entity.name.function.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>-&gt;|==|!=|&lt;=|&gt;=|//|[&lt;&gt;=+*/%\-]</string>
			<key>name</key>
			<string>keyword.operator.wgt</string>
		</dict>
		<dict>
			<key>match</key>
			<string>[\[\](),.:]</string>
			<key>name</key>
			<string>punctuation.wgt</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>source.wgt</string>
</dict>
</plist>
