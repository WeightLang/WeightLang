<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict><key>name</key><string>WeightLang</string><key>scopeName</key><string>source.wgt</string><key>fileTypes</key><array><string>wgt</string></array><key>patterns</key><array><dict><key>name</key><string>comment.line.number-sign.wgt</string><key>match</key><string>#.*$</string></dict><dict><key>name</key><string>string.quoted.double.wgt</string><key>begin</key><string>"</string><key>end</key><string>"|$</string><key>patterns</key><array><dict><key>name</key><string>constant.character.escape.wgt</string><key>match</key><string>\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4})</string></dict></array></dict><dict><key>match</key><string>\b(fn)\s+([A-Za-z_][A-Za-z0-9_]*)</string><key>captures</key><dict><key>1</key><dict><key>name</key><string>keyword.control.wgt</string></dict><key>2</key><dict><key>name</key><string>entity.name.function.wgt</string></dict></dict></dict><dict><key>name</key><string>support.function.wgt</string><key>match</key><string>(?&lt;![\w.])(?:add|append|argmax|argmin|argsort|assert|batch|bce_logits|benchmark|clip|close|column|commit_gradients|compress|concat|cosine_similarity|cross_entropy|cross_entropy_probs|cumsum|dependency|detach|diff|differentiate|differentiate_at|dot|elu|ema|entropy|exp|expm1|fit|fma|full|gae|gate|gather|gradient_snapshot|hard_sigmoid|hard_swish|hf_dataset|huber|hypot|identity|js_divergence|jsonl|kl_divergence|l2_normalize|leaky_relu|len|linear|linspace|load_checkpoint|load_model|log|log1p|log_cosh|log_softmax|logsumexp|mae|max|mean|median|metric|min|minimum|mlp|model|moving_mean|mse|mul|norm|normalize_probabilities|one_hot|ones|positive|predict|quantile|random|range|read|reinforce|release_gradient|relu|restore|reverse|route|rsqrt|save|save_checkpoint|save_model|seed|sigmoid|silu|slice|softmax|softplus|sort|sqrt|square|stddev|sum|tanh|temperature_softmax|train|variance|vector_slice|write|zeros)(?=\s*\()</string></dict><dict><key>name</key><string>keyword.control.wgt</string><key>match</key><string>\b(?:assert|break|collect|continue|else|fn|for|from|frozen|if|import|in|init|input|layer|let|mix|model|onehot|operators|output|parameter|return|sample|then|train|on|rate|clip|target|wgt|while|yield|size)\b</string></dict><dict><key>name</key><string>storage.type.wgt</string><key>match</key><string>\b(?:f32|logits|prob|probabilities)\b</string></dict><dict><key>name</key><string>constant.language.wgt</string><key>match</key><string>\b(?:false|null|true)\b</string></dict><dict><key>name</key><string>variable.parameter.wgt</string><key>match</key><string>\b[A-Za-z_][A-Za-z0-9_]*(?=\s*=(?!=))</string></dict><dict><key>name</key><string>support.function.wgt</string><key>match</key><string>\b(?:linear|relu|tanh|sigmoid|identity)\b</string></dict><dict><key>name</key><string>constant.numeric.wgt</string><key>match</key><string>(?&lt;![\w.])-?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][-+]?\d+)?(?![\w.])</string></dict><dict><key>name</key><string>entity.name.function.wgt</string><key>match</key><string>\b[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*(?=\s*\()</string></dict><dict><key>name</key><string>keyword.operator.wgt</string><key>match</key><string>==|!=|&lt;=|&gt;=|&amp;&amp;|\|\||[&lt;&gt;=!+*/%\-]</string></dict><dict><key>name</key><string>punctuation.wgt</string><key>match</key><string>[\[\](){},.:;]</string></dict></array></dict></plist>
