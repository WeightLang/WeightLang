wgt 0.5
use std/rotary

# x: [T,dim]；arg1/arg2: cos/sin [1,T,rotary_dim]；arg3: bool keep [heads,T,T]。
# 纯 f32 的门控 GQA，无 padding/cache 隐式状态。mask 和位置数据必须显式输入。
# q_proj 的每个头包含 query 与 gate，不能先在整个投影向量中间切一刀。
# q/k/v/o 投影参数独立、各自跨 token 共享；q_norm/k_norm 为 offset RMSNorm。
# 参数名与旧 Qwen Attention 一致，便于显式 state_dict 迁移；默认只是初始化，未训练。
# scale 必须由调用方传 1/sqrt(head_dim)，heads 必须是 kv_heads 的整数倍。
block attention(dim,heads,kv_heads,head_dim,rotary_dim,scale,eps=1e-6):
  layer q_proj: linear(in=dim,out=2*heads*head_dim,bias=0) from input
  layer q_split: split_axis(axis=-1,parts=heads)
  layer q_raw: slice(axis=-1,start=0,stop=head_dim)
  layer q_norm: rmsnorm(dim=head_dim,eps=eps,offset=1)
  layer q_heads: transpose_axes(axis1=0,axis2=1)
  layer q_rotated: rotary.partial(dim=head_dim,rotary=rotary_dim) from q_heads,arg1,arg2
  layer gate_raw: slice(axis=-1,start=head_dim,stop=2*head_dim) from q_split
  layer gate_flat: merge_axes(axis=-2)
  layer gate: sigmoid
  layer k_proj: linear(in=dim,out=kv_heads*head_dim,bias=0) from input
  layer k_split: split_axis(axis=-1,parts=kv_heads)
  layer k_norm: rmsnorm(dim=head_dim,eps=eps,offset=1)
  layer k_heads: transpose_axes(axis1=0,axis2=1)
  layer k_rotated: rotary.partial(dim=head_dim,rotary=rotary_dim) from k_heads,arg1,arg2
  layer k_expanded: repeat_interleave(axis=0,repeats=heads//kv_heads)
  layer k_transposed: transpose_axes(axis1=-1,axis2=-2)
  layer v_proj: linear(in=dim,out=kv_heads*head_dim,bias=0) from input
  layer v_heads: rotary.heads(count=kv_heads)
  layer v_expanded: repeat_interleave(axis=0,repeats=heads//kv_heads)
  # logits/mask 都是 [heads,T,T]；keep=true 可见，全屏蔽行明确返回零。
  layer logits: matmul from q_rotated,k_transposed
  layer scaled: scale(factor=scale)
  layer probabilities: masked_softmax(axis=-1) from scaled,arg3
  layer attended: matmul from probabilities,v_expanded
  layer merged: rotary.merge_heads()
  layer gated: mul(merged,gate)
  layer o_proj: linear(in=heads*head_dim,out=dim,bias=0)
  return output=o_proj
