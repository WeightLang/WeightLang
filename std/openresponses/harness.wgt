wgt 0.5
module OpenResponsesHarness

# next(session, profile) -> future of a protocol step; await inside async fn.
# session is the current worker's opaque handle, profile an explicitly granted
# name. Native scope limits and the shared ledger remain authoritative.
# No model weights are created or trained; no tool is dispatched here.
async fn next(session, profile) {
    return await responses_next(session, profile);
}

# submit(session, results) -> null. results is a list of {call_id, output}.
# Submit the complete pending round; native validation rejects missing,
# duplicate and unknown IDs atomically. Caller executes each tool explicitly.
fn submit(session, results) {
    return responses_submit(session, results);
}

# finished(step) -> bool. A tools step needs explicit results and another next.
# Other successful protocol states are terminal (including incomplete/failed);
# this predicate never claims that the response completed successfully.
fn finished(step) {
    return step.status != "tools";
}
