wgt 0.5
# mse/mae 对单条 [元素] 轴取平均；交叉熵输入 [类别] logits 和零起始类别编号。
# 返回监控用 f64 标量，不创建梯度或隐式更新模型。
fn main() {
    assert(mse([1, 3], [1, 1]) > 1.999999, "mse");
    assert(mae([1, 3], [1, 1]) == 1, "mae");
    assert(cross_entropy([1000, -1000], 1) == 2000, "logits loss");
    return cross_entropy([0, 0], 0);
}
