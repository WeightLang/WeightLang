wgt 0.5
operators Losses

# squared_error(prediction: f32[N], target: f32[N]) -> f32[1].
# Reduce the nonempty feature axis, not the training batch axis. No broadcast.
# The trainer separately averages samples. No weights or state are created.
fn squared_error(prediction, target) {
    let residual = prediction - target, errors = square(residual);
    return mean(errors);
}

# half_squared_error(prediction: f32[N], target: f32[N]) -> f32[1].
# Scale after reduction so the explicit constant has the same f32[1] shape.
fn half_squared_error(prediction, target) {
    let average = squared_error(prediction, target);
    return average * [0.5];
}

# categorical_logits(logits: f32[N], target: f32[N]) -> f32[1].
# N is the class axis. Use logits and nonnegative unit-sum one-hot/soft targets.
# Stable log_softmax avoids taking log of an underflowed probability.
# This pure function does not validate target distributions; arbitrary finite
# targets follow the weighted formula. Both arguments remain differentiable.
fn categorical_logits(logits, target) {
    let log_probabilities = log_softmax(logits), weighted = target * log_probabilities;
    return -sum(weighted);
}
