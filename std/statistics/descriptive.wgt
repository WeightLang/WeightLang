wgt 0.5
# 一维 [观测] 轴归约成标量；ddof=0 是总体方差，ddof=1 是样本方差。
# 无训练状态；quantile 使用排序后位置 q*(N-1) 的线性插值。
fn main() {
    assert(min([3, 1, 2]) == 1, "minimum");
    assert(max([3, 1, 2]) == 3, "maximum");
    assert(variance([1, 3], 0) > 0.999999, "population variance");
    assert(stddev([1, 3], 0) > 0.999999, "population deviation");
    assert(median([1, 2, 3, 4]) == 2.5, "even median");
    assert(quantile([0, 10], 0.25) == 2.5, "interpolation");
    return variance([1, 2, 3], 1);
}
