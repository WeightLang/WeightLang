prelude native 0.5;

# Public native declarations; implementations remain in the named Rust sources.
# @contexts ["ordinary_function"]
# @purpose "Configure one execution-only OpenResponses harness and shared worker ledger."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_scope(limits,profiles,tools);

# @contexts ["ordinary_function"]
# @purpose "Restrict inherited profile/tool grants before creating a session."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_restrict(profiles,tools);

# @contexts ["ordinary_function"]
# @purpose "Create an owned OpenResponses conversation."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_session(request);

# @contexts ["ordinary_function"]
# @purpose "Create an async request future; await it inside async fn."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_next(session,profile);

# @contexts ["ordinary_function"]
# @purpose "Submit exactly one result for every pending call_id."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_submit(session,results);

# @contexts ["ordinary_function"]
# @purpose "Close a local session and discard pending tool calls."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_cancel(session);

# @contexts ["ordinary_function"]
# @purpose "Read aggregate harness usage across workers."
# @implementation "crates/wgtime-core/src/script/openresponses.rs"
# @documentation "docs/openresponses.md"
native fn responses_usage();

# @contexts ["ordinary_function"]
# @purpose "在临时参数上用首次梯度句柄保存的同批数据重新求一阶梯度，不写真实模型；返回新句柄，parameters/state/steps仍为原始提交基准，loss/gradients为临时点结果。共享句柄及内存预算，拒绝过期版本。"
# @implementation "crates/wgtime-core/src/script/optimization.rs"
# @documentation "docs/native-training.md"
native fn differentiate_at(gradient,parameters);

# @contexts ["ordinary_function"]
# @purpose "CPU forward 模型通过 fn loss 求批次平均损失和初始参数梯度，不提交；要求 optimizer none。返回梯度句柄，最多16个存活句柄，共享64MiB预算。"
# @implementation "crates/wgtime-core/src/script/optimization.rs"
# @documentation "docs/native-training.md"
native fn differentiate(model,inputs,targets);

# @contexts ["ordinary_function"]
# @purpose "读取梯度快照对象：loss、parameters、gradients、names、shapes、state、steps；参数按稳定顺序列出非冻结参数，数据为行优先扁平列表。"
# @implementation "crates/wgtime-core/src/script/optimization.rs"
# @documentation "docs/native-training.md"
native fn gradient_snapshot(gradient);

# @contexts ["ordinary_function"]
# @purpose "原子提交完整候选参数和用户优化器状态，返回更新前loss并释放句柄；拒绝过期快照、非有限f32、布局错误和资源状态。状态深度至多32、计量大小至多1MiB。"
# @implementation "crates/wgtime-core/src/script/optimization.rs"
# @documentation "docs/native-training.md"
native fn commit_gradients(gradient,parameters,state);

# @contexts ["ordinary_function"]
# @purpose "释放未提交梯度快照并返回null；重复释放或提交后的句柄报错。Runtime结束释放所有剩余句柄。"
# @implementation "crates/wgtime-core/src/script/optimization.rs"
# @documentation "docs/native-training.md"
native fn release_gradient(gradient);

# @contexts ["ordinary_function"]
# @purpose "返回设备对象列表，字段 id/name/backend/kind/memory_model；CPU 在首项，之后为硬件 GPU。CPU 构建仅返回 CPU。枚举不证明模型可执行；设备编号不代表永久身份。"
# @implementation "crates/wgtime-core/src/script/training_device.rs"
# @documentation "docs/wgsl.md"
native fn devices();

# @contexts ["ordinary_function"]
# @purpose "顺序模型（声明式或 mlp）显式选择训练设备，返回与 training_status 相同的对象。device 为 cpu 或 devices 返回的精确 GPU ID，不接受 auto/gpu/npu。后两项为正整数；GPU 用于数值内存预算和最大批次，CPU 接受但不使用这两个限制。失败保持原设备、权重和优化器状态。"
# @implementation "crates/wgtime-core/src/script/training_device.rs"
# @documentation "docs/wgsl.md"
native fn training_device(model,device,memory_bytes,max_batch);

# @contexts ["ordinary_function"]
# @purpose "返回 device、steps、inference_device、state。steps 是已提交优化步数；当前 inference_device 恒为 cpu、state 恒为 host_committed。只接受顺序模型。"
# @implementation "crates/wgtime-core/src/script/training_device.rs"
# @documentation "docs/wgsl.md"
native fn training_status(model);

# @contexts ["ordinary_function"]
# @purpose "source 是 1..1048576 字节 WGSL 字符串，entry 为非空计算入口名，device 为精确硬件 GPU ID，memory_bytes 为正整数。编译并返回不透明内核句柄，不调度。每个 WGT runtime 最多 64 个内核，退出时释放。"
# @implementation "crates/wgtime-core/src/script/training_device.rs"
# @documentation "docs/wgsl.md"
native fn wgsl_kernel(source,entry,device,memory_bytes);

# @contexts ["ordinary_function"]
# @purpose "input 为非空有限 f32 列表，output_count 正整数；workgroups 为三个正整数 [x,y,z]，每项不超过设备限制。同步调度并返回长度 output_count 的有限 f32 列表；输出初始为零。"
# @implementation "crates/wgtime-core/src/script/training_device.rs"
# @documentation "docs/wgsl.md"
native fn wgsl_run(kernel,input,output_count,workgroups);

# @contexts ["ordinary_function"]
# @purpose "输入为匹配模型宽度的有限 f32 向量；工作和字节参数为 1..1000000000 整数，分别收紧到 compute 余量和 workspace 上限；内存另不得超过原会话上限。准备独立事务，不执行 forward；返回 null。每次尝试消耗一个能力调用名额，工作额度须大于零，内存至少容纳模型的静态受管区。"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/working-memory.md"
native fn execution_start(model,input,max_work,memory_bytes);

# @contexts ["ordinary_function"]
# @purpose "instructions 为 1..1000000；最多执行这么多 VM 指令，同时受剩余计算工作量、生命周期工作上限和当前作用域约束。返回 `{done,output,work,memory_bytes,peak_memory_bytes}`。未完成 output=null，完成后是 f32 输出向量。work 为本任务累计工作量，内存字段仅为动态工作区字节。"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/working-memory.md"
native fn execution_resume(model,instructions);

# @contexts ["ordinary_function"]
# @purpose "取消活动事务并丢弃中间内存和权重写入；有任务返回 true，无任务返回 false。已完成工作不退款。"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/working-memory.md"
native fn execution_cancel(model);

# @contexts ["ordinary_function"]
# @purpose "每次运行只能设置一次。四个参数均为 [0,1000000000] 整数，calls 最大 10000。work 受当前解释器剩余操作额度约束；deadline 从此调用起计时。返回 null。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/compute-budget.md"
native fn compute_budget(work,workspace_bytes,calls,deadline_ms);

# @contexts ["ordinary_function"]
# @purpose "返回 work_remaining、workspace_bytes、calls_remaining、deadline_remaining_ms 对象。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/compute-budget.md"
native fn compute_status();

# @contexts ["ordinary_function"]
# @purpose "input 为列表；返回 `{ok,error,value,work}`。需要先设置预算。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/compute-budget.md"
native fn compute_call(name,input);

# @contexts ["ordinary_function"]
# @purpose "返回本次运行的调用摘要列表：capability、input_length、work、ok、error。不记录输入内容。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/compute-budget.md"
native fn compute_trace();

# @contexts ["ordinary_function"]
# @purpose "返回可用的版本化能力名列表：三个计算能力，以及宿主授权的 I/O 能力。不需要初始化预算。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/compute-budget.md"
native fn compute_capabilities();

# @contexts ["ordinary_function"]
# @purpose "Return host policy counters or null without a policy."
# @implementation "crates/wgtime-core/src/script/resources.rs"
native fn compute_host_status();

# @contexts ["ordinary_function"]
# @purpose "Call a WGT function within a child resource budget."
# @implementation "crates/wgtime-core/src/script/resources.rs"
native fn compute_scope(function,args,limits);

# @contexts ["ordinary_function"]
# @purpose "Register a one-argument WGT function as a capability."
# @implementation "crates/wgtime-core/src/script/resources.rs"
native fn compute_register(name,function,limits);

# @contexts ["ordinary_function"]
# @purpose "model 为原生顺序 f32 模型句柄，不支持 adaptive 句柄；input 为与输入宽度相同的有限数值列表；alias 为授权别名。返回 `{ok,job,work,error}`，成功 job 为本设备池整数 ID；准入拒绝时 job=null、work=0。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/accelerator-resources.md"
native fn device_submit(model,input,alias);

# @contexts ["ordinary_function"]
# @purpose "job 为该池提交返回的整数，timeout_ms 为 [0,1000000000]。返回 `{ok,output,error,execution_wall_us}`；output 为 f32 推理结果列表。等待期限同时受当前计算预算与宿主剩余期限限制。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/accelerator-resources.md"
native fn device_wait(alias,job,timeout_ms);

# @contexts ["ordinary_function"]
# @purpose "返回实际设备 ID、kind（Gpu/Npu）、active、ready、queued、并发/队列上限、受管内存额度、每任务额度、提交计数/余量、计算量/余量。未经授权的别名报错。"
# @implementation "crates/wgtime-core/src/script/resources.rs"
# @documentation "docs/accelerator-resources.md"
native fn device_status(alias);

# @contexts ["ordinary_function"]
# @purpose "Resolve an explicitly locked dependency to its local artifact path."
# @implementation "crates/wgtime-core/src/script.rs"
native fn dependency(name);

# @contexts ["ordinary_function"]
# @purpose "列表长度"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn len(list);

# @contexts ["ordinary_function"]
# @purpose "非负整数半开区间；end >= start，最多 1000000 项"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn range(start,end);

# @contexts ["ordinary_function"]
# @purpose "返回追加后的新列表，不原地改动；最多 1000000 项"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn append(list,value);

# @contexts ["ordinary_function"]
# @purpose "从对象列表逐行提取字段，缺失即报错"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn column(rows,key);

# @contexts ["ordinary_function"]
# @purpose "Sum a finite nonempty numeric list to a scalar; reject nonfinite results."
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn sum(x);

# @contexts ["ordinary_function"]
# @purpose "Scalar square root; reject nonfinite results."
# @implementation "crates/wgtime-core/src/script.rs"
native fn sqrt(x);

# @contexts ["ordinary_function"]
# @purpose "`1/sqrt(x)`，x > 0；精确平方根再取倒数，未使用低精度快速近似"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn rsqrt(x);

# @contexts ["ordinary_function"]
# @purpose "融合乘加 x*y+z，只舍入一次"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn fma(x,y,z);

# @contexts ["ordinary_function"]
# @purpose "欧氏长度，避免直接平方造成中间溢出/下溢"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn hypot(x,y);

# @contexts ["ordinary_function"]
# @purpose "exp(x)-1，保留接近零的小量精度"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn expm1(x);

# @contexts ["ordinary_function"]
# @purpose "log(1+x)，x > -1，保留接近零的小量精度"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn log1p(x);

# @contexts ["ordinary_function"]
# @purpose "logistic，按正负分支避免指数溢出"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn sigmoid(x);

# @contexts ["ordinary_function"]
# @purpose "max(x,0)+log1p(exp(-abs(x)))，避免大正数指数溢出"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn softplus(x);

# @contexts ["ordinary_function"]
# @purpose "x*sigmoid(x)，使用稳定 sigmoid"
# @implementation "crates/wgtime-core/src/script/math/mod.rs"
# @documentation "docs/standard-library.md"
native fn silu(x);

# @contexts ["ordinary_function"]
# @purpose "标量内积；长度相同，顺序 FMA 累加"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn dot(x,y);

# @contexts ["ordinary_function"]
# @purpose "标量 L2 长度；逐步 hypot 避免直接平方溢出"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn norm(x);

# @contexts ["ordinary_function"]
# @purpose "标量均值；先除 N 再求和以减少求和溢出；后缀无参数，语义及预算相同"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn mean(x);

# @contexts ["ordinary_function"]
# @purpose "`[N]` 概率；减最大值后指数归一化"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn softmax(x);

# @contexts ["ordinary_function"]
# @purpose "`[N]` 对数概率；直接在对数域计算，避免概率下溢后取 log"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn log_softmax(x);

# @contexts ["ordinary_function"]
# @purpose "标量 log(sum(exp(x)))；减最大值稳定计算"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn logsumexp(x);

# @contexts ["ordinary_function"]
# @purpose "`[N]`，x/max(norm(x),eps)；eps 有限且 >0；缩放后求范数，零向量返回零"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn l2_normalize(x,eps);

# @contexts ["ordinary_function"]
# @purpose "标量均方误差；等长，均值取全部 N 个元素"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn mse(x,y);

# @contexts ["ordinary_function"]
# @purpose "标量平均绝对误差；等长"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn mae(x,y);

# @contexts ["ordinary_function"]
# @purpose "单样本标量负对数似然；target 为 0..N-1 的整数，不接受概率标签"
# @implementation "crates/wgtime-core/src/script/math/vector.rs"
# @documentation "docs/standard-library.md"
native fn cross_entropy(logits,target);

# @contexts ["ordinary_function"]
# @purpose "标量最小/最大值"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn min(x);

# @contexts ["ordinary_function"]
# @purpose "标量最小/最大值"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn max(x);

# @contexts ["ordinary_function"]
# @purpose "极值首次出现的索引，数值相等的正负零也按首次处理"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn argmin(x);

# @contexts ["ordinary_function"]
# @purpose "极值首次出现的索引，数值相等的正负零也按首次处理"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn argmax(x);

# @contexts ["ordinary_function"]
# @purpose "标量方差，分母 N-ddof；ddof 为整数且 0<=ddof<N；0 是总体方差、1 是样本方差"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn variance(x,ddof);

# @contexts ["ordinary_function"]
# @purpose "同一方差定义的标准差；先缩放和中心化，避免直接平方溢出"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn stddev(x,ddof);

# @contexts ["ordinary_function"]
# @purpose "排序后中位数；偶数长度取中间两数平均"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn median(x);

# @contexts ["ordinary_function"]
# @purpose "q 为 [0,1] 数值；对升序序列位置 q*(N-1) 做线性插值，单元素返回该元素"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn quantile(x,q);

# @contexts ["ordinary_function"]
# @purpose "升序 `[N]`，稳定排序；不修改原列表"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn sort(x);

# @contexts ["ordinary_function"]
# @purpose "升序对应的原始索引 `[N]`，相等元素保持原顺序"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn argsort(x);

# @contexts ["ordinary_function"]
# @purpose "包含当前元素的顺序前缀和 `[N]`；任何中间和溢出均报错"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn cumsum(x);

# @contexts ["ordinary_function"]
# @purpose "标量余弦相似度，等长且两个向量均非零；分别缩放后求内积与范数，最终裁剪到 [-1,1]"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn cosine_similarity(x,y);

# @contexts ["ordinary_function"]
# @purpose "逐元素裁剪到闭区间，同形返回；两边界有限且 lower<=upper"
# @implementation "crates/wgtime-core/src/script/math/algorithms.rs"
# @documentation "docs/standard-library.md"
native fn clip(x,lower,upper);

# @contexts ["ordinary_function"]
# @purpose "标量 max(x,0)"
# @implementation "crates/wgtime-core/src/script/math/activation.rs"
# @documentation "docs/standard-library.md"
native fn relu(x);

# @contexts ["ordinary_function"]
# @purpose "x>=0 时 x，否则 alpha*x；alpha 有限且 >=0"
# @implementation "crates/wgtime-core/src/script/math/activation.rs"
# @documentation "docs/standard-library.md"
native fn leaky_relu(x,alpha);

# @contexts ["ordinary_function"]
# @purpose "x>=0 时 x，否则 alpha*expm1(x)；alpha 有限且 >=0"
# @implementation "crates/wgtime-core/src/script/math/activation.rs"
# @documentation "docs/standard-library.md"
native fn elu(x,alpha);

# @contexts ["ordinary_function"]
# @purpose "标量 clamp(x/6+0.5,0,1)，端点 -3 与 3"
# @implementation "crates/wgtime-core/src/script/math/activation.rs"
# @documentation "docs/standard-library.md"
native fn hard_sigmoid(x);

# @contexts ["ordinary_function"]
# @purpose "标量 x*hard_sigmoid(x)，分段计算避免中间溢出"
# @implementation "crates/wgtime-core/src/script/math/activation.rs"
# @documentation "docs/standard-library.md"
native fn hard_swish(x);

# @contexts ["ordinary_function"]
# @purpose "等长 `[N]` → 标量均值二元交叉熵；targets 每项在 [0,1]，支持软标签；输入为 logits 而非概率"
# @implementation "crates/wgtime-core/src/script/math/loss.rs"
# @documentation "docs/standard-library.md"
native fn bce_logits(logits,targets);

# @contexts ["ordinary_function"]
# @purpose "等长 `[N]` → 标量均值；delta 有限且 >0；绝对残差 d<=delta 时 0.5*d²，否则 delta*(d-0.5*delta)"
# @implementation "crates/wgtime-core/src/script/math/loss.rs"
# @documentation "docs/standard-library.md"
native fn huber(x,y,delta);

# @contexts ["ordinary_function"]
# @purpose "等长 `[N]` → 标量均值 log(cosh(x-y))，小残差用 log1p，大残差在对数域计算"
# @implementation "crates/wgtime-core/src/script/math/loss.rs"
# @documentation "docs/standard-library.md"
native fn log_cosh(x,y);

# @contexts ["ordinary_function"]
# @purpose "`[N]` → `[N-1]`，输出 x[i+1]-x[i]；N>=2"
# @implementation "crates/wgtime-core/src/script/math/signal.rs"
# @documentation "docs/standard-library.md"
native fn diff(x);

# @contexts ["ordinary_function"]
# @purpose "`[N]` → `[N]`；y[0]=x[0]，y[t]=(1-alpha)*y[t-1]+alpha*x[t]；0<alpha<=1"
# @implementation "crates/wgtime-core/src/script/math/signal.rs"
# @documentation "docs/standard-library.md"
native fn ema(x,alpha);

# @contexts ["ordinary_function"]
# @purpose "`[N]` → `[N-window+1]`，仅有效窗口、不填充；window 是 1..N 的整数"
# @implementation "crates/wgtime-core/src/script/math/signal.rs"
# @documentation "docs/standard-library.md"
native fn moving_mean(x,window);

# @contexts ["ordinary_function"]
# @purpose "长度 count 的全零列表，count 为 0..1,000,000 的整数"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn zeros(count);

# @contexts ["ordinary_function"]
# @purpose "同上，填充 1"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn ones(count);

# @contexts ["ordinary_function"]
# @purpose "同上，填充有限 f64 value；即使 count=0 也验证 value"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn full(count,value);

# @contexts ["ordinary_function"]
# @purpose "等间距列表，含两端点；start/end 有限，count 为 1..1,000,000 整数；count=1 仅返回 start，支持降序"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn linspace(start,end,count);

# @contexts ["ordinary_function"]
# @purpose "拼接 `[N]` 与 `[M]` 为 `[N+M]`，总长度不超过上限"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn concat(x,y);

# @contexts ["ordinary_function"]
# @purpose "左闭右开 `[start,end)`，要求整数 0<=start<=end<=N；输出 `[end-start]`，不支持步长或负索引"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn vector_slice(x,start,end);

# @contexts ["ordinary_function"]
# @purpose "按整数索引列表顺序取值，输出长度等于索引数；允许重复，全部索引须在 0..N-1，空 indices 合法"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn gather(x,indices);

# @contexts ["ordinary_function"]
# @purpose "mask 是等长 bool 列表，仅保留 true 位置且保持顺序；不将 0/1 隐式转为 bool；全 false 返回空列表"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn compress(x,mask);

# @contexts ["ordinary_function"]
# @purpose "`[classes]`，index 位置为 1，其余为 0；classes 是 1..1,000,000 整数，index 是 0..classes-1 整数"
# @implementation "crates/wgtime-core/src/script/one_hot.rs"
# @documentation "docs/standard-library.md"
native fn one_hot(index,classes);

# @contexts ["ordinary_function"]
# @purpose "返回倒序的新 `[N]` 列表"
# @implementation "crates/wgtime-core/src/script/math/data.rs"
# @documentation "docs/standard-library.md"
native fn reverse(x);

# @contexts ["ordinary_function"]
# @purpose "标量 Shannon 熵 `-sum(p*log(p))`，零概率项贡献为 0"
# @implementation "crates/wgtime-core/src/script/math/probability.rs"
# @documentation "docs/standard-library.md"
native fn entropy(p);

# @contexts ["ordinary_function"]
# @purpose "非负权重、至少一项>0；先除最大值再归一化，返回同形概率列表，避免直接求和溢出"
# @implementation "crates/wgtime-core/src/script/math/probability.rs"
# @documentation "docs/standard-library.md"
native fn normalize_probabilities(weights);

# @contexts ["ordinary_function"]
# @purpose "等长分布，标量 `sum(p*(log(p)-log(q)))`；方向是目标 p 相对参考 q，不对称"
# @implementation "crates/wgtime-core/src/script/math/probability.rs"
# @documentation "docs/standard-library.md"
native fn kl_divergence(p,q);

# @contexts ["ordinary_function"]
# @purpose "等长分布，标量 `(KL(p,m)+KL(q,m))/2`，m=(p+q)/2；对称，精确值在 [0,log(2)]"
# @implementation "crates/wgtime-core/src/script/math/probability.rs"
# @documentation "docs/standard-library.md"
native fn js_divergence(p,q);

# @contexts ["ordinary_function"]
# @purpose "等长分布，标量 `-sum(p*log(q))`；p 是目标分布，q 是预测概率；不同于接受 logits 和类别编号的 `cross_entropy`"
# @implementation "crates/wgtime-core/src/script/math/probability.rs"
# @documentation "docs/standard-library.md"
native fn cross_entropy_probs(p,q);

# @contexts ["ordinary_function"]
# @purpose "正且有限的温度；同形输出 softmax(logits/temperature)，温度 1 对应普通 softmax"
# @implementation "crates/wgtime-core/src/script/math/probability.rs"
# @documentation "docs/standard-library.md"
native fn temperature_softmax(logits,temperature);

# @contexts ["ordinary_function"]
# @purpose "Scalar natural logarithm; reject nonfinite results."
# @implementation "crates/wgtime-core/src/script.rs"
native fn log(x);

# @contexts ["ordinary_function"]
# @purpose "Scalar exponential; reject nonfinite results."
# @implementation "crates/wgtime-core/src/script.rs"
native fn exp(x);

# @contexts ["ordinary_function"]
# @purpose "按名称保存 JSON 指标；同名覆盖，只保留最后值，不自动平均或 detach"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn metric(name,value);

# @contexts ["ordinary_function"]
# @purpose "设置脚本局部采样 RNG；整数范围 [0,1000000000]"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn seed(integer);

# @contexts ["ordinary_function"]
# @purpose "确定性 SplitMix64 流，返回 [0,1)；不影响模型初始化 RNG"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn random();

# @contexts ["ordinary_function"]
# @purpose "新建 CPU f32 顺序网络；widths 是包括输入输出的 2..64 个整数，每个 1..16384，最多 4000000 参数；隐藏层 activation 为 relu/tanh/sigmoid/identity，输出层始终 linear；optimizer 为 sgd/adam"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn mlp(widths,activation,seed,optimizer);

# @contexts ["ordinary_function"]
# @purpose "一批观测的策略梯度更新，返回更新前的 mean(-advantage*log pi(action))"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn reinforce(model,observations,actions,advantages,lr);

# @contexts ["ordinary_function"]
# @purpose "同长度一维列表；后两种标记是 bool，gamma/lambda 在 [0,1]；返回优势列表"
# @implementation "crates/wgtime-core/src/script.rs"
# @documentation "docs/native-training.md"
native fn gae(rewards,values,next_values,terminated,truncated,gamma,lambda);

# @contexts ["ordinary_function"]
# @purpose "打开 UTF-8 JSON Lines 数据流；每行一个 JSON 值，不允许空行"
# @implementation "crates/wgtime-core/src/script/dataset.rs"
# @documentation "docs/native-training.md"
native fn jsonl(path);

# @contexts ["ordinary_function"]
# @purpose "Rust 原生 Hugging Face 分页数据流；全部参数必填，首次 batch 联网；HF_TOKEN 可选，详见 [数据集契约](datasets.md#原生数据集加载器wgt-05当前源码)"
# @implementation "crates/wgtime-core/src/script/dataset.rs"
# @documentation "docs/native-training.md"
native fn hf_dataset(dataset,config,split);

# @contexts ["ordinary_function"]
# @purpose "count 在 1..65536；返回最多 count 行；尾批保留，到 EOF 返回 []；单行 <=1MiB、单批 <=16MiB"
# @implementation "crates/wgtime-core/src/script/dataset.rs"
# @documentation "docs/native-training.md"
native fn batch(reader,count);

# @contexts ["ordinary_function"]
# @purpose "关闭流，重复关闭无操作；关闭后 batch 报错"
# @implementation "crates/wgtime-core/src/script/dataset.rs"
# @documentation "docs/native-training.md"
native fn close(reader);

# @contexts ["ordinary_function"]
# @purpose "mode 默认 cpu；支持同步 GPU 前向和 train:cpu MSE 训练步；warmup 0..10000，repeats 1..100000；完整契约见[原生测试](native-testing.md#benchmark)"
# @implementation "crates/wgtime-core/src/script/benchmark.rs"
# @documentation "docs/native-training.md"
native fn benchmark(model,workload,warmup,repeats,name,mode = "cpu");

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Stop the input gradient."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic detach(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Elementwise exponential."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic exp(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Elementwise natural logarithm."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic log(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Stable vector log probabilities."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic log_softmax(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Elementwise minimum; ties split gradients equally."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic minimum(a,b);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Elementwise clamp using signed literal bounds; zero gradient at endpoints."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic clip(x,low,high);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Reduce f32[N] to f32[1]."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic sum(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "f32[3]：剩余前向工作量、剩余工作区字节、存活工作区字节；无梯度"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic resource_state();

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "address:f32[N] 每项在 [0,1]，返回加权读取的 f32[D]；不隐式归一化，支持内存和地址梯度"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic memory_read(bank,address);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "读取参数当前值，结果为扁平向量；直接引用参数也会读取"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic read(parameter);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Affine tensor transform x by weight, with optional bias vector; output width is weight row count."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic linear(x,weight,bias = "absent (no bias)");

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "等长逐元素运算，无广播"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic add(a,b);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "等长逐元素运算，无广播"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic mul(a,b);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Reduce f32[N] to f32[1]; also x.mean."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic mean(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Elementwise square."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic square(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "返回 p*x；x 为 f32[N]，p 为 f32[1] 或 f32[N]，每项须在 [0,1]；标量门广播；推理时 p 全为 0 跳过 x 表达式"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic gate(p,x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "返回 p*a+(1-p)*b；a/b 同为 f32[N]，p 为 f32[1] 或 f32[N] 且在 [0,1]；推理时 p 全为 1 只求值 a，全为 0 只求值 b，否则计算两边"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic route(p,a,b);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "等长逐元素运算"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic relu(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "等长逐元素运算"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic tanh(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "等长逐元素运算"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic sigmoid(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "f32[N] 沿唯一向量轴归一化，返回 f32[N]；稳定指数实现，支持一阶梯度"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic softmax(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Slice fixed tensor using literal zero-based start and positive length; no default arguments."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "expression"
native intrinsic slice(x,start,length);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "Condition only: f32[1] strictly greater than zero."
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "condition"
native intrinsic positive(x);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "两个 1..16384 的整数常量，分配零初始化 f32[N,D] 工作区并返回专用句柄；禁止复制或当作张量"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "binding"
native intrinsic memory_alloc(slots,width);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "全量替换非冻结参数，元素数须相同"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "statement"
native intrinsic write(parameter,value);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "释放工作区；未分配、重复释放或释放后访问报错"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "statement"
native intrinsic memory_free(bank);

# @contexts ["tensor_forward","tensor_loss"]
# @purpose "value:f32[D]，每槽更新为 `(1-address[i])*旧值+address[i]*value`；支持地址、旧值和新值梯度"
# @implementation "crates/wgt-language/src/adaptive/source.rs"
# @documentation "docs/reference.zh-CN.md"
# @position "statement"
native intrinsic memory_write(bank,address,value);
