wgt 0.5
# [元素] -> [元素] 或原始索引；相等元素按原先顺序排列，argmin/argmax 取首次。
# 函数不修改调用方列表，无权重或训练；cumsum 是包含当前元素的前缀和。
fn main() {
    let x = [3, 1, 3];
    assert(sort(x) == [1, 3, 3], "ascending");
    assert(argsort(x) == [1, 0, 2], "stable indices");
    assert(argmin(x) == 1, "minimum index");
    assert(argmax(x) == 0, "first maximum");
    assert(cumsum([1, 2, 3]) == [1, 3, 6], "inclusive prefix");
    assert(x == [3, 1, 3], "input unchanged");
    return argsort(x);
}
