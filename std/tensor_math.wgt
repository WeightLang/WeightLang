wgt 0.5

# 沿最后一条样本轴归一化；保留该轴为 1，再显式广播回输入。
# batch 不参与归约。无参数、无训练；eps 位于 rsqrt 内，与 Qwen L2Norm 一致。
block l2norm(eps=1e-6):
  layer squared: square from input
  layer total: reduce_sum(axis=-1,keepdim=1)
  layer stabilized: shift(value=eps)
  layer inverse: rsqrt
  layer expanded: broadcast from inverse,input
  layer output: mul(input,expanded)

# 仅做无仿射 RMS 归一化，不创建或复用可训练权重。
# 门控/权重乘法由调用方显式组合，避免隐含的参数身份或混合精度转换。
block rms(eps=1e-6):
  layer squared: square from input
  layer average: reduce_mean(axis=-1,keepdim=1)
  layer stabilized: shift(value=eps)
  layer inverse: rsqrt
  layer expanded: broadcast from inverse,input
  layer output: mul(input,expanded)
