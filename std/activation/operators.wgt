wgt 0.5
operators Activation

# swish(x: f32[N]) -> f32[N]. N is a nonempty feature axis, not a batch.
# The native sigmoid avoids overflow for large negative gates.
# No parameters or mutable state are allocated; gradients flow through x.
fn swish(x) {
    let probability = sigmoid(x), gated = x * probability;
    return gated;
}

# swiglu(gate: f32[N], value: f32[N]) -> f32[N]. Both inputs are required.
# The caller supplies both projected branches and owns any shared weights.
# Gate features modulate matching value features; there is no broadcasting.
fn swiglu(gate, value) {
    let activated = swish(gate), output = activated * value;
    return output;
}

# squared_relu(x: f32[N]) -> f32[N]. Keeps the feature axis unchanged.
# Negative and zero inputs have zero gradient; finite overflow is an error.
fn squared_relu(x) {
    let positive_features = relu(x);
    return square(positive_features);
}
