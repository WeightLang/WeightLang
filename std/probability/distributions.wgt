wgt 0.5
# 一条 [类别] 轴，分布总和约等于 1；所有对数均为自然对数，结果单位为 nat。
# 仅分析数值，不创建权重或训练梯度；KL 参数顺序是目标 p、参考 q。
fn main() {
    assert(normalize_probabilities([2, 2]) == [0.5, 0.5], "normalize weights");
    assert(entropy([1, 0]) == 0, "certain distribution");
    assert(kl_divergence([0.5, 0.5], [0.5, 0.5]) == 0, "identical distributions");
    assert(js_divergence([1, 0], [0, 1]) > 0.69, "disjoint support is finite");
    assert(cross_entropy_probs([1, 0], [1, 0]) == 0, "zero target mass ignored");
    return entropy([0.5, 0.5]);
}
