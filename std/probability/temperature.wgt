wgt 0.5
# logits 的 [类别] 轴保持不变；正温度越大分布越平缓，参数必须显式传入。
# 先减最大值再求指数，避免大 logits 溢出；不是随机采样或训练操作。
fn main() {
    assert(temperature_softmax([1000, 1000], 0.5) == [0.5, 0.5], "equal logits");
    let cold = temperature_softmax([0, 2], 0.5);
    let hot = temperature_softmax([0, 2], 2);
    assert(cold[1] > hot[1], "temperature changes concentration");
    return temperature_softmax([-1e308, 1e308], 1e308);
}
