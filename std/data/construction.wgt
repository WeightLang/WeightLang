wgt 0.5
# 构造一维 [元素] 列表，无模型参数或训练状态；独热向量沿 [类别] 轴编码。
# linspace 含两端点，count=1 只返回起点；长度均显式指定。
fn main() {
    assert(zeros(3) == [0, 0, 0], "zeros");
    assert(ones(2) == [1, 1], "ones");
    assert(full(2, -3) == [-3, -3], "fill");
    assert(linspace(0, 1, 3) == [0, 0.5, 1], "inclusive grid");
    # [3] 是类别轴长度，索引 1 选中第二类；离散索引不参与求导。
    assert(onehot[3] 1 == [0, 1, 0], "class axis");
    return linspace(1, -1, 3);
}
