wgt 0.5
# 输入是单条 [元素] 轴；索引从零开始，切片采用左闭右开区间。
# gather 可重排和重复元素；compress 按 bool 掩码保留顺序；不修改原列表。
fn main() {
    let x = [10, 20, 30];
    assert(concat(x, [40]) == [10, 20, 30, 40], "concatenate");
    assert(vector_slice(x, 1, 3) == [20, 30], "half open slice");
    assert(gather(x, [2, 0, 2]) == [30, 10, 30], "gather");
    assert(compress(x, [true, false, true]) == [10, 30], "mask");
    assert(reverse(x) == [30, 20, 10], "reverse");
    assert(x == [10, 20, 30], "unchanged input");
    return compress(x, [false, false, false]);
}
