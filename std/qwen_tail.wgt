wgt 0.5
use std/gated_attention
use std/tensor_math

# 各投影独立，跨 token 共享；门是 SiLU，不是概率。输入输出 [T,dim]。
block mlp(dim,hidden):
  layer gate_proj: linear(in=dim,out=hidden,bias=0) from input
  layer gate: silu
  layer up_proj: linear(in=dim,out=hidden,bias=0) from input
  layer gated: mul(gate,up_proj)
  layer down_proj: linear(in=hidden,out=dim,bias=0)

# 四输入 input/cos/sin/keep。两次 pre-norm 均使用 offset 权重，保留旧参数名。
block decoder(dim,hidden,heads,kv_heads,head_dim,rotary_dim,scale,eps=1e-6):
  layer input_layernorm: rmsnorm(dim=dim,eps=eps,offset=1) from input
  layer self_attn: gated_attention.attention(dim=dim,heads=heads,kv_heads=kv_heads,head_dim=head_dim,rotary_dim=rotary_dim,scale=scale,eps=eps) from input_layernorm,arg1,arg2,arg3
  layer residual: add(input,self_attn)
  layer post_attention_layernorm: rmsnorm(dim=dim,eps=eps,offset=1)
  layer mlp: mlp(dim=dim,hidden=hidden)
  layer output: add(residual,mlp)
  return output=output

# 首轮改造：up 需由初始化文件置零，才能严格保留基座；block 本身不强制初始化。
block surgery(dim,rank):
  layer down: linear(in=dim,out=rank,bias=0) from input
  layer activated: silu
  layer up: linear(in=rank,out=dim,bias=0)
  layer output: add(input,up)

# 供 recur 使用的单轮修正；factor 通常为 1/steps。
# 无仿射 RMS 只归一化新分支。相同 recur 内共享三套投影，不同 recur 相互独立。
# up 零初始化时严格恒等；非零后梯度穿过所有共享迭代，输入输出均为 f32[T,dim]。
block refinement_step(dim,rank,factor,eps=1e-6):
  layer normalized: tensor_math.rms(eps=eps) from input
  layer gate: linear(in=dim,out=rank,bias=0) from normalized
  layer probability: sigmoid
  layer value: linear(in=dim,out=rank,bias=0) from normalized
  layer activated: silu
  layer gated: mul(probability,activated)
  layer up: linear(in=rank,out=dim,bias=0)
  layer update: scale(factor=factor)
  layer output: add(input,update)
